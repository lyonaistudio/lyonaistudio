<style>
  .offre-tab { color: var(--color-paper-dim); }
  .offre-tab:hover { color: var(--color-paper); background: rgb(255 255 255 / 0.04); }
  .offre-tab[aria-selected="true"] { color: #fff; background: var(--color-accent-button); box-shadow: 0 8px 25px -10px rgb(255 0 61 / 0.6); }
  .offre-tab:focus-visible { outline: 2px solid var(--color-accent-soft); outline-offset: 2px; }
</style>

<script>
  // Onglets « Site internet » / « Automatisation IA ». Lien direct : /tarifs/#automatisation
  function initOffres() {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-offre-tab]")];
    const panels = [...document.querySelectorAll<HTMLElement>("[data-offre-panel]")];
    if (!tabs.length) return;
    const montrer = (id: string, focus = false) => {
      for (const t of tabs) {
        const actif = t.dataset.offreTab === id;
        t.setAttribute("aria-selected", String(actif));
        t.tabIndex = actif ? 0 : -1;
        if (actif && focus) t.focus();
      }
      for (const p of panels) p.hidden = p.dataset.offrePanel !== id;
    };
    const depuisAdresse = () => montrer(location.hash === "#automatisation" ? "auto" : "site");
    for (const t of tabs) {
      t.addEventListener("click", () => {
        const id = t.dataset.offreTab!;
        montrer(id);
        history.replaceState(history.state, "", id === "auto" ? "#automatisation" : location.pathname + location.search);
        const haut = document.querySelector<HTMLElement>("[role=tablist]")!.getBoundingClientRect().top;
        if (haut < 0 || haut > 140) window.scrollTo({ top: window.scrollY + haut - 90, behavior: "smooth" });
      });
      t.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
        e.preventDefault();
        const i = (tabs.indexOf(t) + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        montrer(tabs[i].dataset.offreTab!, true);
      });
    }
    const w = window as unknown as { __offresHash?: () => void };
    if (w.__offresHash) window.removeEventListener("hashchange", w.__offresHash);
    w.__offresHash = depuisAdresse;
    window.addEventListener("hashchange", depuisAdresse);
    depuisAdresse();
  }
  document.addEventListener("astro:page-load", initOffres);
</script>
