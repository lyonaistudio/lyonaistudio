---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import CTASection from "../components/CTASection.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Realisations from "../components/Realisations.astro";
import { faqSchema } from "../lib/schema";
import { SITE } from "../lib/site";
import { FORMULES, CREATION_SITE, PRIX_PAGE_SUP, ENGAGEMENT_MOIS, RASSURANCE, enGras, euros, AUTOMATISATIONS, AUTO_ENGAGEMENT_MOIS, AUTO_REMISE, AUTO_PRIX_MIN, mensualiteAuto, CONTENU } from "../lib/formules";

const croissance = FORMULES.find((f) => f.id === "croissance")!;
const premiereAnnee = CREATION_SITE + 12 * croissance.prix;
// Exemple d'automatisation pour un artisan (mêmes calculs que le devis)
const exempleAuto = ["relanceDevis", "relanceFactures", "avis"];
const exempleAutoNoms = AUTOMATISATIONS.filter((a) => exempleAuto.includes(a.id)).map((a) => a.nom);
const exempleAutoBrut = AUTOMATISATIONS.filter((a) => exempleAuto.includes(a.id)).reduce((s, a) => s + a.prix, 0);
const exempleAutoPrix = mensualiteAuto(exempleAuto);
const remisePct = Math.round(AUTO_REMISE.taux * 100);

const faqItems = [
  {
    question: "Pourquoi un abonnement plutôt qu'un site payé en une fois ?",
    answer: `Parce que vous n'avez pas à avancer 1 500 ou 3 000 € d'un coup : la création coûte ${euros(CREATION_SITE)} HT, puis l'abonnement couvre l'hébergement, les modifications et la visibilité sur Google. Votre site ne vieillit pas dans son coin : il est entretenu et amélioré chaque mois.`,
  },
  {
    question: `Que comprend la création à ${euros(CREATION_SITE)} ?`,
    answer: "La conception, le design sur mesure, le développement et la mise en ligne de votre site, adapté au téléphone et réglé pour Google. On s'occupe aussi de votre fiche Google, au niveau prévu par votre formule.",
  },
  {
    question: "Combien de temps suis-je engagé ?",
    answer: `${ENGAGEMENT_MOIS} mois à partir de la mise en ligne du site. Ensuite, l'abonnement continue au mois et vous pouvez l'arrêter avec un mois de préavis. Après la signature, vous avez 14 jours pour changer d'avis, et aucun paiement n'est demandé pendant ce délai.`,
  },
  {
    question: "Le site et le nom de domaine m'appartiennent-ils ?",
    answer: "Le nom de domaine (votre adresse internet) est toujours enregistré à votre nom. Après les 24 premiers mois, vous pouvez aussi récupérer le site lui-même, avec ses fichiers et le transfert, pour 390 € HT.",
  },
  {
    question: "Puis-je changer de formule ?",
    answer: "Oui. Vous pouvez passer à une formule supérieure à tout moment, et revenir à une formule inférieure à la date anniversaire de votre abonnement.",
  },
  {
    question: "Et si j'ai besoin de plus de pages ou d'une fonctionnalité en plus ?",
    answer: `Chaque page au-delà de votre formule coûte ${euros(PRIX_PAGE_SUP)} HT par mois. Les options (prise de rendez-vous, adresses e-mail pro, boutique en ligne, site traduit, assistant IA…) s'ajoutent à votre mensualité : leur prix figure sur votre devis.`,
  },
  {
    question: "Puis-je automatiser des tâches sans prendre de site ?",
    answer: `Oui. Chaque automatisation (relance des devis, prise de rendez-vous, demande d'avis Google, assistant IA…) se paie uniquement chaque mois, dès ${euros(AUTO_PRIX_MIN)} HT, sans frais de mise en service. ${remisePct} % de remise dès ${AUTO_REMISE.des} automatisations. Engagement de ${AUTO_ENGAGEMENT_MOIS} mois, puis sans engagement. Elles fonctionnent avec vos outils actuels : messagerie, agenda, logiciel de devis.`,
  },
  {
    question: "Comment se passe le paiement ?",
    answer: "Par prélèvement automatique, chaque mois, sur facture. Vous pouvez aussi payer à l'année : 2 mois de formule vous sont alors offerts. Tous les prix sont indiqués hors taxes.",
  },
];
const schema = faqSchema(faqItems);

const offresAuto = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Automatisation de tâches par l'IA",
  description: "Automatisations branchées sur vos outils, payées chaque mois, sans frais de mise en service.",
  provider: { "@type": "Organization", name: SITE.name, url: SITE.url },
  areaServed: "FR",
  offers: AUTOMATISATIONS.map((a) => ({
    "@type": "Offer",
    name: a.nom,
    description: a.desc,
    priceCurrency: "EUR",
    priceSpecification: { "@type": "UnitPriceSpecification", price: a.prix, priceCurrency: "EUR", unitText: "mois", valueAddedTaxIncluded: false },
  })),
};

const offres = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Site internet en abonnement",
  provider: { "@type": "Organization", name: SITE.name, url: SITE.url },
  areaServed: "FR",
  offers: [
    { "@type": "Offer", name: "Création du site", price: CREATION_SITE, priceCurrency: "EUR", valueAddedTaxIncluded: false },
    ...FORMULES.map((f) => ({
      "@type": "Offer",
      name: `Formule ${f.nom}`,
      description: f.objectif,
      priceCurrency: "EUR",
      priceSpecification: { "@type": "UnitPriceSpecification", price: f.prix, priceCurrency: "EUR", unitText: "mois", valueAddedTaxIncluded: false },
    })),
  ],
};

const comparaison = [
  ["Au départ", "800 à 6 000 € à payer d'un coup", `${euros(CREATION_SITE)} HT, une seule fois`],
  ["Hébergement et entretien", "30 à 300 € par mois en plus", "Compris dans l'abonnement"],
  ["Modifications", "Facturées à chaque demande", "Comprises chaque mois"],
  ["Contenu pour Google", "Rarement prévu", "Articles et posts Google chaque mois"],
  ["Dans 3 ans", "Un site à refaire, et à repayer", "Refonte totale comprise"],
];

const inclusPartout = [
  ["Votre nom de domaine, à votre nom", "Votre adresse internet vous appartient, quoi qu'il arrive."],
  ["Un hébergement rapide et sécurisé", "Sauvegardes, mises à jour de sécurité et certificat HTTPS compris."],
  ["Pas de grosse avance", `${euros(CREATION_SITE)} HT pour créer le site, puis une mensualité fixe.`],
  ["14 jours pour changer d'avis", "Aucun paiement n'est demandé pendant ce délai."],
];

// Libellés des lignes du tableau des formules (la valeur de chaque formule est dans la colonne)
const LIBELLES: Record<string, string> = {
  "Pages sur mesure": "Pages sur mesure",
  "Hébergement + nom de domaine": "Hébergement + nom de domaine",
  "Fiche Google": "Fiche Google",
  "Modifications par mois": "Modifications par mois",
  "Rapport de visites": "Rapport de visites",
  "Articles de blog": "Articles de blog",
  "Posts sur Google": "Posts sur Google",
  "Avis Google sur le site": "Avis Google affichés sur votre site",
  "Refonte totale": "Refonte totale du site",
  "Suivi Google": "Suivi de mots-clés sur Google",
  "Pages Google par ville": "Pages dédiées par ville",
  "Automatisation IA": "Automatisation IA offerte",
};

const options = ["Prise de rendez-vous en ligne", "Adresses e-mail pro", "Petite boutique en ligne", "Site traduit", "Relance automatique des devis", "Assistant IA", "Gestion de la publicité Google", "Réseaux sociaux"];
---

<BaseLayout
  title="Tarifs : site internet dès 49 € HT par mois | Lyon AI Studio"
  description={`Création de site sur mesure à ${CREATION_SITE} € HT, puis un abonnement dès 49 € HT par mois. Automatisation IA sans site dès ${AUTO_PRIX_MIN} € HT par mois, sans frais de mise en service.`}
  path="/tarifs/"
  jsonLd={[schema, offres, offresAuto]}
>
  <Breadcrumb items={[{ name: "Tarifs", url: "/tarifs/" }]} />
  <PageHero
    compact
    eyebrow="TARIFS"
    title="Des tarifs clairs, payés chaque mois"
    description="Un site internet qui vous amène des clients, ou des tâches automatisées pour gagner du temps. Prix hors taxes, sans surprise."
  />

  <!-- Choix de l'offre : deux onglets, toujours visibles en haut de l'écran -->
  <div class="sticky top-[4.5rem] z-30 border-b border-ink-line bg-ink/95 backdrop-blur-md">
    <div class="mx-auto max-w-6xl px-6 py-2">
      <div class="grid grid-cols-2 gap-1.5 rounded-2xl border border-white/10 bg-ink-soft p-1" role="tablist" aria-label="Choisir une offre">
        <button type="button" role="tab" id="tab-site" aria-controls="offre-site" aria-selected="true" data-offre-tab="site" class="offre-tab rounded-xl px-3 py-1.5 text-left transition-colors sm:px-4">
          <span class="block font-display text-sm font-bold">Site internet</span>
          <span class="block text-xs opacity-80">{euros(CREATION_SITE)} puis dès 49 € HT/mois</span>
        </button>
        <button type="button" role="tab" id="tab-auto" aria-controls="automatisation" aria-selected="false" tabindex="-1" data-offre-tab="auto" class="offre-tab rounded-xl px-3 py-1.5 text-left transition-colors sm:px-4">
          <span class="block font-display text-sm font-bold">Automatisation IA</span>
          <span class="block text-xs opacity-80">dès {euros(AUTO_PRIX_MIN)} HT/mois, rien au départ</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ================= SITE INTERNET ================= -->
  <div id="offre-site" role="tabpanel" aria-labelledby="tab-site" data-offre-panel="site">
    <section class="mx-auto max-w-6xl px-6 pt-3 pb-12" aria-labelledby="formules-titre">
      <h2 id="formules-titre" class="sr-only">Les formules de site internet</h2>

      <!-- Ordinateur : un tableau, chaque ligne écrite une seule fois -->
      <div class="hidden overflow-hidden rounded-2xl border border-white/10 md:block">
        <table class="w-full table-fixed text-left text-sm">
          <caption class="sr-only">Comparaison des formules Essentiel, Croissance et Performance (prix HT par mois)</caption>
          <colgroup><col class="w-[31%]" />{FORMULES.map(() => <col />)}</colgroup>
          <thead>
            <tr class="align-top">
              <td class="bg-ink-soft px-4 py-2 align-bottom text-xs leading-relaxed text-paper-dim">
                Création du site : <strong class="text-paper">{euros(CREATION_SITE)} HT</strong>, une seule fois.<br />Chaque formule comprend la précédente.
              </td>
              {FORMULES.map((f) => (
                <th scope="col" class:list={["px-4 py-2 font-normal", f.conseillee ? "bg-accent-button text-white" : "bg-ink-soft"]}>
                  <span class="flex items-center justify-between gap-2">
                    <span class:list={["text-xs font-bold tracking-[0.18em] uppercase", f.conseillee ? "text-white" : "text-paper-dim"]}>{f.nom}</span>
                    {f.conseillee && <span class="rounded-full bg-white px-2 py-0.5 text-[0.7rem] font-bold text-accent-button">Conseillée</span>}
                  </span>
                  <span class="mt-1 block font-display text-3xl font-bold leading-none">{f.prix}&nbsp;€<span class:list={["ml-1 text-xs font-medium", f.conseillee ? "text-white/80" : "text-paper-dim"]}>HT / mois</span></span>
                  <span class:list={["mt-1.5 block min-h-[2.6em] text-xs leading-snug", f.conseillee ? "text-white/90" : "text-paper-dim"]}>{f.objectif}</span>
                  <a
                    href={`/contact/?formule=${f.id}`}
                    class:list={[
                      "mt-1.5 inline-flex min-h-[30px] w-full items-center justify-center rounded-full px-4 text-xs font-bold transition-colors",
                      f.conseillee ? "bg-white text-accent-button hover:bg-white/90" : "border border-white/20 text-paper hover:border-accent hover:text-accent",
                    ]}
                  >Demander mon devis</a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {CONTENU.map((r) => (
              <tr class="border-t border-white/5">
                <th scope="row" class="px-4 py-[0.2rem] font-medium text-paper">{LIBELLES[r.t] ?? r.t}</th>
                {r.v.map((val, i) => (
                  <td class:list={["px-4 py-[0.2rem]", FORMULES[i].conseillee ? "bg-accent-button/10 font-semibold text-paper" : "text-paper-dim"]}>
                    {val === 0 ? <span class="text-mist" aria-label="non compris">–</span> : val === 1 ? <span class="font-bold text-accent" aria-label="compris">✓</span> : String(val)}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Téléphone : une carte compacte par formule -->
      <div class="space-y-3 md:hidden">
        {FORMULES.map((f) => (
          <article class:list={["rounded-2xl p-4", f.conseillee ? "bg-[linear-gradient(170deg,#ff0a45_0%,#c4002f_100%)] text-white" : "border border-white/10 bg-ink-soft"]} aria-labelledby={`m-${f.id}`}>
            <div class="flex items-baseline justify-between gap-3">
              <h3 id={`m-${f.id}`} class:list={["text-xs font-bold tracking-[0.18em] uppercase", f.conseillee ? "text-white" : "text-paper-dim"]}>{f.nom}{f.conseillee && " · conseillée"}</h3>
              <p class="font-display text-2xl font-bold leading-none">{f.prix}&nbsp;€<span class:list={["ml-1 text-xs font-medium", f.conseillee ? "text-white/80" : "text-paper-dim"]}>HT/mois</span></p>
            </div>
            <p class:list={["mt-1 text-sm", f.conseillee ? "text-white/90" : "text-paper-dim"]}>{f.objectif}</p>
            <ul class="mt-3 grid grid-cols-1 gap-1 text-sm">
              {f.lignes.filter((l) => l.inclus).map((l) => (
                <li class="flex gap-2"><span class:list={["font-bold", f.conseillee ? "text-white" : "text-accent"]} aria-hidden="true">✓</span><span set:html={enGras(l.texte)} /></li>
              ))}
            </ul>
            <a href={`/contact/?formule=${f.id}`} class:list={["mt-3 inline-flex min-h-[44px] w-full items-center justify-center rounded-full px-4 text-sm font-bold", f.conseillee ? "bg-white text-accent-button" : "border border-white/20 text-paper"]}>Demander mon devis {f.nom}</a>
          </article>
        ))}
      </div>

      <p class="mt-3 text-center text-xs leading-relaxed text-paper-dim sm:text-sm">
        <span class="text-accent" aria-hidden="true">✓</span> {RASSURANCE} · Engagement {ENGAGEMENT_MOIS} mois, puis sans engagement · Page en plus : {euros(PRIX_PAGE_SUP)} HT/mois · Devis gratuit
      </p>
    </section>

    <!-- Compris partout + options -->
    <section class="mx-auto max-w-6xl px-6 pb-12">
      <div class="grid gap-6 rounded-3xl border border-white/10 p-6 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <h2 class="font-display text-lg font-semibold text-paper">Compris dans toutes les formules</h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2">
            {inclusPartout.map(([titre, texte]) => (
              <li class="flex gap-3">
                <span class="mt-0.5 font-bold text-accent" aria-hidden="true">✓</span>
                <span><span class="block text-sm font-semibold text-paper">{titre}</span><span class="block text-xs leading-relaxed text-paper-dim">{texte}</span></span>
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:border-l lg:border-white/10 lg:pl-6">
          <h2 class="font-display text-lg font-semibold text-paper">Des options selon votre métier</h2>
          <p class="mt-1 text-xs text-paper-dim">Ajoutées à votre mensualité, chiffrées sur votre devis.</p>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {options.map((o) => (
              <li class="rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-paper">{o}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Pourquoi un abonnement -->
    <section class="border-y border-ink-line bg-ink-soft/60">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <h2 class="font-display text-2xl font-bold text-paper">Pourquoi un abonnement plutôt qu'un site classique ?</h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-paper-dim">Un site acheté une fois vieillit vite : il n'est plus mis à jour, il descend dans Google, et dans trois ans il faut tout refaire. Avec l'abonnement, il reste à jour et visible, pour une mensualité connue d'avance.</p>

        <div class="mt-6 grid gap-6 lg:grid-cols-[1.6fr_1fr]">
          <ul class="space-y-3 sm:hidden">
            {comparaison.map(([critere, classique, nous]) => (
              <li class="rounded-2xl border border-white/10 p-4">
                <p class="font-display font-semibold text-paper">{critere}</p>
                <p class="mt-1 text-sm text-paper-dim"><span class="text-mist">Site classique :</span> {classique}</p>
                <p class="mt-1 text-sm font-medium text-paper"><span class="text-accent">Lyon AI Studio :</span> {nous}</p>
              </li>
            ))}
          </ul>
          <div class="hidden overflow-hidden rounded-2xl border border-white/10 sm:block">
            <table class="w-full text-left text-sm">
              <caption class="sr-only">Comparaison entre un site classique et l'abonnement Lyon AI Studio</caption>
              <thead>
                <tr class="border-b border-white/10">
                  <th scope="col" class="px-4 py-2.5 font-semibold text-paper-dim"></th>
                  <th scope="col" class="px-4 py-2.5 font-semibold text-paper-dim">Site classique (agence ou freelance)</th>
                  <th scope="col" class="bg-accent-button/15 px-4 py-2.5 font-display font-bold text-paper">Lyon AI Studio</th>
                </tr>
              </thead>
              <tbody>
                {comparaison.map(([critere, classique, nous]) => (
                  <tr class="border-b border-white/5 last:border-0">
                    <th scope="row" class="px-4 py-2.5 font-semibold text-paper">{critere}</th>
                    <td class="px-4 py-2.5 text-paper-dim">{classique}</td>
                    <td class="bg-accent-button/10 px-4 py-2.5 font-medium text-paper">{nous}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="flex flex-col justify-between rounded-2xl border border-accent/40 bg-[linear-gradient(160deg,#2a030c_0%,#161616_70%)] p-6">
            <div>
              <p class="text-sm font-semibold text-accent">Exemple : la formule Croissance</p>
              <p class="mt-2 font-display font-semibold text-paper">Votre première année, tout compris</p>
              <p class="mt-1 font-display text-4xl font-bold tracking-tight text-paper">{euros(premiereAnnee)} <span class="text-base font-medium text-paper-dim">HT</span></p>
              <p class="mt-1 text-sm text-paper-dim">{euros(CREATION_SITE)} de création + 12 × {euros(croissance.prix)}</p>
            </div>
            <ul class="mt-4 space-y-1.5 text-sm text-paper">
              <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span>Le site sur mesure, en ligne</li>
              <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span>12 articles et 24 posts Google</li>
              <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span>36 modifications possibles</li>
              <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span>Hébergement, nom de domaine et suivi</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ================= AUTOMATISATION IA ================= -->
  <div id="automatisation" role="tabpanel" aria-labelledby="tab-auto" data-offre-panel="auto" hidden>
    <section class="mx-auto max-w-6xl px-6 pt-3 pb-12" aria-labelledby="auto-titre">
      <h2 id="auto-titre" class="sr-only">Automatisation IA, sans site</h2>
      <div class="grid gap-4 lg:grid-cols-[2fr_1fr] lg:items-start">
        <ul class="grid gap-2.5 sm:grid-cols-2">
          {AUTOMATISATIONS.map((a) => (
            <li class="rounded-2xl border border-white/10 bg-ink-soft px-4 py-3">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-sm font-semibold leading-snug text-paper">{a.nom}</h3>
                <p class="shrink-0 font-display text-lg font-bold leading-none text-paper">{a.prix}&nbsp;€<span class="ml-0.5 text-[0.7rem] font-medium text-paper-dim">/mois</span></p>
              </div>
              <p class="mt-1 text-xs leading-snug text-paper-dim">{a.desc}</p>
            </li>
          ))}
          <li class="rounded-2xl border border-dashed border-white/20 px-4 py-3">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-sm font-semibold text-paper">Une autre tâche répétitive ?</h3>
              <p class="shrink-0 text-xs font-semibold text-paper-dim">sur devis</p>
            </div>
            <p class="mt-1 text-xs leading-snug text-paper-dim">Une automatisation sur mesure, avec un prix mensuel fixé avant de commencer.</p>
          </li>
        </ul>

        <div class="rounded-2xl border border-accent/40 bg-[linear-gradient(160deg,#2a030c_0%,#161616_70%)] p-5 lg:sticky lg:top-36">
          <ul class="space-y-1 text-sm text-paper">
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span><span><strong>Aucuns frais au départ</strong>, seulement la mensualité</span></li>
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span><span><strong>{remisePct} % de remise</strong> dès {AUTO_REMISE.des} automatisations</span></li>
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span><span>Engagement {AUTO_ENGAGEMENT_MOIS} mois, puis sans engagement</span></li>
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span><span>14 jours pour changer d'avis</span></li>
          </ul>
          <div class="mt-4 border-t border-white/10 pt-4">
            <p class="text-xs font-semibold text-accent">Exemple : un artisan</p>
            <p class="mt-1 text-xs leading-snug text-paper-dim">{exempleAutoNoms.join(" + ")}</p>
            <p class="mt-2 font-display text-3xl font-bold tracking-tight text-paper">{euros(exempleAutoPrix)} <span class="text-sm font-medium text-paper-dim">HT / mois</span></p>
            <p class="text-xs text-paper-dim">au lieu de {euros(exempleAutoBrut)}, rien à payer au départ</p>
          </div>
          <a
            href="/contact/?formule=automatisation"
            class="mt-4 inline-flex min-h-[44px] w-full items-center justify-center rounded-full bg-accent-button px-5 text-sm font-bold text-white transition-colors hover:bg-accent-soft"
          >
            Demander mon devis automatisation
          </a>
        </div>
      </div>
      <p class="mt-3 text-center text-xs leading-relaxed text-paper-dim sm:text-sm">
        Prix HT, payés par prélèvement chaque mois. On branche les automatisations sur vos outils (messagerie, agenda, logiciel de devis) ; vos abonnements à ces outils restent à votre charge.
        Déjà un site avec nous ? Ces fonctions existent aussi en option de votre formule.
      </p>
    </section>
