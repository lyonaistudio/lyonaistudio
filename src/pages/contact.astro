---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import { SITE, FORMSPREE_ENDPOINT } from "../lib/site";
import { faqSchema } from "../lib/schema";

const faqItems = [
  {
    question: "Sous quel délai Lyon AI Studio répond-il à une demande de contact ?",
    answer:
      "Chaque message envoyé via ce formulaire reçoit une réponse personnelle sous 48h ouvrées, généralement plus rapidement. Aucun standard automatisé — c'est moi qui lis et réponds à chaque demande.",
  },
  {
    question: "Dois-je préciser un budget avant de vous contacter ?",
    answer:
      "Non, ce n'est pas nécessaire. Décrivez simplement votre besoin et votre activité — je vous propose ensuite une estimation adaptée après avoir compris le projet, pas un tarif générique déconnecté de votre situation réelle.",
  },
  {
    question: "Puis-je vous contacter par téléphone plutôt que par formulaire ?",
    answer:
      "Oui, mes coordonnées sont indiquées sur cette page. Le formulaire reste le moyen le plus rapide pour décrire un besoin en détail, mais un échange téléphonique est possible dès que le projet est cerné.",
  },
  {
    question: "Que se passe-t-il après l'envoi du formulaire de contact ?",
    answer:
      "Vous recevez une confirmation immédiate à l'écran, puis une réponse personnelle par email sous 48h. L'étape suivante est décrite en détail sur la page <a href=\"/comment-ca-se-passe/\" class=\"text-accent underline underline-offset-2\">déroulement d'un projet</a>.",
  },
  {
    question: "Intervenez-vous pour des entreprises situées hors de Lyon ?",
    answer:
      "L'activité est basée à Lyon, mais l'ensemble du travail se fait à distance : je travaille avec des clients partout en France, pas seulement dans la région lyonnaise.",
  },
];
const schema = faqSchema(faqItems);
---

<BaseLayout
  title="Contact — Lyon AI Studio"
  description="Contactez Lyon AI Studio pour un projet de site internet ou d'automatisation IA. Réponse personnelle sous quelques jours."
  path="/contact/"
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "Contact", url: "/contact/" }]} />
  <PageHero
    eyebrow="CONTACT"
    title="Parlons de votre projet"
    description="Décrivez votre besoin, je vous réponds personnellement — sans prix imposé avant d'avoir échangé."
  />

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <div id="success-banner" class="mb-8 hidden rounded-2xl border border-accent bg-ink-soft p-6" role="status" aria-live="polite">
          <p class="font-display font-semibold text-accent">Message envoyé.</p>
          <p class="mt-1 text-sm text-paper-dim">Merci, je reviens vers vous rapidement.</p>
        </div>

        <div id="error-banner" class="mb-8 hidden rounded-3xl bg-ink-soft p-6" role="alert" aria-live="polite">
          <p class="font-display font-semibold text-paper">Envoi impossible pour le moment.</p>
          <p class="mt-1 text-sm text-paper-dim">
            Réessayez, ou écrivez-moi directement à
            <a href={`mailto:${SITE.email}`} class="text-accent transition-colors hover:text-accent-soft">{SITE.email}</a>.
          </p>
        </div>

        <form
          id="contact-form"
          action={FORMSPREE_ENDPOINT}
          method="POST"
          class="space-y-6"
        >
          <input type="hidden" name="_subject" value="Nouvelle demande — Lyon AI Studio" />
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="prenom" class="text-sm font-semibold text-paper-dim">Prénom</label>
              <input
                id="prenom"
                name="Prénom"
                type="text"
                required
                class="mt-2 w-full rounded-2xl border border-white/20 bg-white/[0.06] px-4 py-3 text-paper placeholder:text-mist transition-all focus:border-accent focus:shadow-[0_0_0_3px_rgba(255,0,61,0.15)] focus:outline-none"
              />
            </div>
            <div>
              <label for="nom" class="text-sm font-semibold text-paper-dim">Nom</label>
              <input
                id="nom"
                name="Nom"
                type="text"
                required
                class="mt-2 w-full rounded-2xl border border-white/20 bg-white/[0.06] px-4 py-3 text-paper placeholder:text-mist transition-all focus:border-accent focus:shadow-[0_0_0_3px_rgba(255,0,61,0.15)] focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="email" class="text-sm font-semibold text-paper-dim">Email</label>
            <input
              id="email"
              name="Email"
              type="email"
              required
              class="mt-2 w-full rounded-2xl border border-white/20 bg-white/[0.06] px-4 py-3 text-paper placeholder:text-mist transition-all focus:border-accent focus:shadow-[0_0_0_3px_rgba(255,0,61,0.15)] focus:outline-none"
            />
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="type-entreprise" class="text-sm font-semibold text-paper-dim">
                Type d'entreprise
              </label>
              <select
                id="type-entreprise"
                name="Type d'entreprise"
                required
                class="mt-2 w-full rounded-2xl border border-white/20 bg-white/[0.06] px-4 py-3 text-paper transition-all focus:border-accent focus:shadow-[0_0_0_3px_rgba(255,0,61,0.15)] focus:outline-none"
              >
                <option value="">Sélectionner…</option>
                <option value="Artisan">Artisan</option>
                <option value="Commerce">Commerce</option>
                <option value="Profession libérale">Profession libérale</option>
                <option value="PME">PME</option>
                <option value="Autre">Autre</option>
              </select>
            </div>
            <div>
              <label for="secteur" class="text-sm font-semibold text-paper-dim">
                Secteur d'activité
              </label>
              <input
                id="secteur"
                name="Secteur d'activité"
                type="text"
                placeholder="Ex. plomberie, coiffure, conseil…"
                class="mt-2 w-full rounded-2xl border border-white/20 bg-white/[0.06] px-4 py-3 text-paper placeholder:text-mist transition-all focus:border-accent focus:shadow-[0_0_0_3px_rgba(255,0,61,0.15)] focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="message" class="text-sm font-semibold text-paper-dim">
              Décrivez ce que vous recherchez
            </label>
            <textarea
              id="message"
              name="Message"
              rows="6"
              required
              class="mt-2 w-full rounded-2xl border border-white/20 bg-white/[0.06] px-4 py-3 text-paper placeholder:text-mist transition-all focus:border-accent focus:shadow-[0_0_0_3px_rgba(255,0,61,0.15)] focus:outline-none"
            ></textarea>
          </div>

          <button
            id="contact-submit"
            type="submit"
            class="rounded-full bg-accent px-6 py-3 text-sm font-bold text-white shadow-[0_16px_32px_-14px_rgba(255,0,61,0.55)] transition-all hover:-translate-y-0.5 hover:bg-accent-soft hover:shadow-[0_20px_40px_-14px_rgba(255,0,61,0.65)] disabled:pointer-events-none disabled:translate-y-0 disabled:cursor-not-allowed disabled:opacity-60 disabled:shadow-none"
          >
            Envoyer la demande
          </button>
        </form>
      </div>

      <aside class="space-y-8">
        <div class="rounded-3xl bg-ink-soft p-6">
          <Eyebrow label="COORDONNÉES" />
          <ul class="mt-4 space-y-3 text-sm text-paper-dim">
            <li>
              <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-accent">{SITE.email}</a>
            </li>
            <li>{SITE.city}, France — intervention à distance</li>
            <li>{SITE.hours}</li>
          </ul>
        </div>

        <div class="rounded-3xl bg-ink-soft p-6">
          <Eyebrow label="ZONE D'INTERVENTION" />
          <div class="mt-4 aspect-video w-full overflow-hidden rounded-2xl grayscale">
            <iframe
              title="Carte — Lyon, France"
              src="https://www.google.com/maps?q=Lyon,France&output=embed"
              class="h-full w-full"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <p class="mt-2 text-xs text-mist">
            Activité basée à Lyon, sans accueil physique — carte à titre indicatif.
          </p>
        </div>

        <div class="rounded-3xl bg-ink-soft/60 p-6">
          <Eyebrow label="RÉPONSE PERSONNELLE" />
          <p class="mt-4 text-sm text-paper-dim">
            Chaque message est lu et traité personnellement par Thomas — pas d'équipe commerciale,
            pas de standardiste. Vous échangez directement avec la personne qui réalisera le
            projet.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16 sm:pb-20">
    <Eyebrow label="QUESTIONS FRÉQUENTES" />
    <h2 class="mt-4 font-display text-2xl font-semibold text-paper sm:text-3xl">
      Avant de nous écrire
    </h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
  </section>
</BaseLayout>

<script>
  import { initContactForm } from "../scripts/contact-form";
  document.addEventListener("astro:page-load", initContactForm);
</script>
