---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CTASection from "../../components/CTASection.astro";
import WorkflowDiagram from "../../components/WorkflowDiagram.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { faqSchema } from "../../lib/schema";

const faqItems = [
  {
    question: "Qu'est-ce qu'un agent IA, concrètement ?",
    answer:
      "C'est un programme capable de lire une demande (message, email, formulaire) et d'agir en conséquence — répondre, transmettre une information, déclencher une action — sans que vous interveniez à chaque fois. Contrairement à un chatbot générique, il est configuré spécifiquement pour votre activité et vos outils, pas pour répondre au hasard.",
  },
  {
    question: "Est-ce que l'automatisation IA remplace un employé ?",
    answer:
      "Non, elle prend en charge les tâches répétitives et à faible valeur ajoutée (accusés de réception, tri, relances), pas la relation client ou les décisions qui demandent votre jugement. L'objectif est de vous redonner du temps, pas de retirer l'humain là où il compte vraiment.",
  },
  {
    question: "Mes données sont-elles en sécurité avec un agent IA ?",
    answer:
      "L'automatisation s'appuie sur des outils professionnels reconnus et n'accède qu'aux informations strictement nécessaires à la tâche demandée. Le fonctionnement exact — quels outils, quelles données, quels accès — vous est expliqué avant la mise en place, sans zone d'ombre.",
  },
  {
    question: "Combien coûte une automatisation IA pour une petite entreprise ?",
    answer:
      "Le prix dépend du nombre de tâches à automatiser et de la complexité des outils à connecter. Plutôt qu'un tarif générique, nous préférons d'abord comprendre ce qui vous fait perdre du temps au quotidien avant de vous proposer un montant clair — voir la page <a href=\"/services/creation-site-internet/\" class=\"text-accent underline underline-offset-2\">création de site internet</a> si vous partez de zéro sur les deux volets.",
  },
  {
    question: "Peut-on automatiser une seule tâche pour commencer ?",
    answer:
      "Oui, et c'est même l'approche recommandée : identifier les deux ou trois tâches qui prennent le plus de temps, les automatiser en priorité, puis élargir si c'est utile. Voir le <a href=\"/comment-ca-se-passe/\" class=\"text-accent underline underline-offset-2\">déroulement d'un projet</a> pour la méthode complète.",
  },
];
const schema = faqSchema(faqItems);

const examples = [
  {
    metier: "Commerce de proximité",
    cases: [
      "Répondre automatiquement aux questions de disponibilité et d'horaires en dehors des heures d'ouverture",
      "Relancer un client qui a demandé un renseignement sans donner suite",
      "Envoyer un message de remerciement et une demande d'avis après un achat",
    ],
  },
  {
    metier: "Artisan / bâtiment",
    cases: [
      "Trier les demandes de devis entrantes par urgence et par type de chantier",
      "Envoyer un rappel automatique de rendez-vous la veille d'une intervention",
      "Relancer un devis envoyé sans réponse après quelques jours",
    ],
  },
  {
    metier: "Profession libérale / cabinet",
    cases: [
      "Prendre un rendez-vous directement depuis un message, sans échange manuel",
      "Répondre aux questions fréquentes (tarifs, documents à apporter, accès) automatiquement",
      "Classer les emails entrants par priorité et préparer une ébauche de réponse",
    ],
  },
];
---

<BaseLayout
  title="Automatisation & agent IA à Lyon — Lyon AI Studio"
  description="Mise en place d'agents IA et de workflows d'automatisation pour les PME et commerces de Lyon : réponses automatiques, prise de rendez-vous, relances."
  path="/services/automatisation-ia/"
  jsonLd={[schema]}
>
  <Breadcrumb
    items={[
      { name: "Services", url: "/services/" },
      { name: "Automatisation IA", url: "/services/automatisation-ia/" },
    ]}
  />
  <PageHero
    eyebrow="SERVICE — AGENT IA"
    title="Automatisation & agent IA"
    description="Des outils qui prennent en charge les tâches répétitives de votre quotidien professionnel, pour vous laisser du temps sur ce qui compte vraiment."
  />

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <Eyebrow label="CE QUE ÇA VEUT DIRE" />
    <h2 class="mt-4 font-display text-2xl font-semibold text-paper sm:text-3xl">
      Un agent IA, concrètement
    </h2>
    <p class="mt-4 leading-relaxed text-paper-dim">
      Un agent IA est un programme capable de lire un message ou une demande, de comprendre ce qui est
      attendu, et d'agir en conséquence — répondre, transmettre l'information, déclencher une action —
      sans que vous ayez à intervenir à chaque fois. Combiné à des workflows d'automatisation
      professionnels, il peut connecter votre messagerie, votre agenda et vos outils existants
      pour faire circuler l'information automatiquement.
    </p>
  </section>

  <section class="border-y border-ink-line bg-ink">
    <div class="mx-auto max-w-5xl px-6 py-14">
      <WorkflowDiagram />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <Eyebrow label="EN PRATIQUE" />
    <h2 class="mt-4 font-display text-2xl font-semibold text-paper sm:text-3xl">
      Un scénario type
    </h2>
    <div class="mt-8 space-y-6 border-l-2 border-ink-line pl-6">
      <div>
        <p class="font-mono text-xs text-accent">DIMANCHE, 21H</p>
        <p class="mt-1 text-sm leading-relaxed text-paper-dim">
          Un client potentiel écrit via le formulaire du site pour demander un devis. Vous n'êtes pas
          devant votre téléphone.
        </p>
      </div>
      <div>
        <p class="font-mono text-xs text-accent">21H01</p>
        <p class="mt-1 text-sm leading-relaxed text-paper-dim">
          L'agent IA envoie un accusé de réception professionnel et personnalisé, et vous notifie
          immédiatement sur votre téléphone.
        </p>
      </div>
      <div>
        <p class="font-mono text-xs text-accent">LUNDI MATIN</p>
        <p class="mt-1 text-sm leading-relaxed text-paper-dim">
          Vous retrouvez la demande classée avec les autres, avec toutes les informations déjà
          organisées — plus qu'à répondre sur le fond, sans avoir raté le contact.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16 sm:pb-20">
    <Eyebrow label="EXEMPLES CONCRETS" />
    <h2 class="mt-4 font-display text-2xl font-semibold text-paper sm:text-3xl">
      Ce que ça peut faire, selon votre métier
    </h2>
    <div class="mt-8 space-y-8">
      {examples.map((group) => (
        <div class="border border-ink-line bg-ink-soft p-6">
          <p class="font-display font-semibold text-paper">{group.metier}</p>
          <ul class="mt-4 space-y-3">
            {group.cases.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-paper-dim">
                <span class="mt-1.5 h-1 w-1 shrink-0 bg-accent" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <Eyebrow label="CE QUE ÇA CHANGE" class="mt-16" />
    <h2 class="mt-4 font-display text-2xl font-semibold text-paper sm:text-3xl">
      Du temps récupéré, pas une usine à gaz
    </h2>
    <p class="mt-4 leading-relaxed text-paper-dim">
      L'objectif n'est pas de tout automatiser d'un coup, mais d'identifier les deux ou trois tâches
      qui vous prennent le plus de temps au quotidien et de les prendre en charge en priorité. Chaque
      mise en place est adaptée à vos outils existants et à votre façon de travailler — vous gardez la
      main sur ce qui compte, l'automatisation s'occupe du reste.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16 sm:pb-20">
    <Eyebrow label="QUESTIONS FRÉQUENTES" />
    <h2 class="mt-4 font-display text-2xl font-semibold text-paper sm:text-3xl">
      Ce que les entreprises lyonnaises demandent le plus
    </h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <CTASection
    title="Une tâche qui vous prend trop de temps ?"
    description="Décrivez-la-nous, on regarde ensemble si elle peut être automatisée et comment."
  />
</BaseLayout>
