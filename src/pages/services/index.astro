---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CTASection from "../../components/CTASection.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { faqSchema } from "../../lib/schema";

const faqItems = [
  {
    question: "Quels services propose Lyon AI Studio ?",
    answer:
      "Deux services complémentaires : la <a href=\"/services/creation-site-internet/\" class=\"text-accent underline underline-offset-2\">création de site internet</a> sur-mesure, et l'<a href=\"/services/automatisation-ia/\" class=\"text-accent underline underline-offset-2\">automatisation par agent IA</a> pour les tâches répétitives. Le tout couvre aussi l'UX/UI, le référencement local et la maintenance, intégrés selon vos besoins.",
  },
  {
    question: "Puis-je combiner création de site et automatisation IA ?",
    answer:
      "Oui, c'est même une combinaison fréquente : un site qui présente bien votre activité, couplé à un agent IA qui traite les demandes entrantes automatiquement. Les deux services sont pensés pour fonctionner ensemble, mais peuvent aussi être pris séparément.",
  },
  {
    question: "Est-ce que je dois savoir ce dont j'ai besoin avant de vous contacter ?",
    answer:
      "Non, c'est même la majorité des situations que nous rencontrons. Notre rôle est de traduire votre besoin en solution technique adaptée, pas l'inverse — décrivez simplement votre activité et ce qui vous prend du temps.",
  },
  {
    question: "Travaillez-vous uniquement avec des entreprises basées à Lyon ?",
    answer:
      "L'activité est basée à Lyon, mais tout le travail se fait à distance : nous travaillons avec des clients partout en France, pas seulement dans la région lyonnaise — voir la page <a href=\"/a-propos/\" class=\"text-accent underline underline-offset-2\">à propos</a> pour en savoir plus sur le fonctionnement.",
  },
  {
    question: "Comment se passe un premier échange avec Lyon AI Studio ?",
    answer:
      "Vous décrivez votre besoin via le <a href=\"/contact/\" class=\"text-accent underline underline-offset-2\">formulaire de contact</a>, par email ou par téléphone. On échange ensuite sur votre activité avant de vous proposer une solution claire, sans jargon ni prix imposé avant d'avoir discuté.",
  },
];
const schema = faqSchema(faqItems);
---

<BaseLayout
  title="Services — Site internet & automatisation IA à Lyon"
  description="Deux services complémentaires : création de site internet et automatisation par IA, pensés pour les artisans, commerces et PME, partout en France."
  path="/services/"
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "Services", url: "/services/" }]} />
  <PageHero
    eyebrow="SERVICES"
    title="Deux services, pensés pour les petites structures"
    description="Un site qui vous représente correctement, et des outils qui prennent en charge ce qui vous fait perdre du temps au quotidien."
  />

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <p class="mx-auto mb-12 max-w-2xl text-center text-lg leading-relaxed text-paper-dim">
      Que vous ayez besoin d'une création web classique ou d'un site IA enrichi d'automatisation, la
      démarche reste la même : comprendre votre activité avant de proposer une solution sur-mesure.
    </p>
    <div class="grid gap-6 md:grid-cols-2">
      <ServiceCard
        index="01"
        title="Création de site internet"
        description="Un site rapide, clair et pensé pour convertir un visiteur en demande de contact — pas un gadget qui prend la poussière."
        points={[
          "Design sur-mesure adapté à votre activité",
          "Optimisé pour le référencement local dès le départ",
          "Impeccable sur mobile, votre principal terminal de consultation",
        ]}
        href="/services/creation-site-internet/"
      />
      <ServiceCard
        index="02"
        title="Automatisation / agent IA"
        description="Des agents IA et workflows qui prennent en charge les tâches répétitives : réponses, rendez-vous, relances, tri d'emails."
        points={[
          "Mis en place avec des outils d'automatisation professionnels et des agents IA sur-mesure",
          "Adapté à votre métier, pas une solution générique",
          "Vous gardez la main, l'IA fait le travail de fond",
        ]}
        href="/services/automatisation-ia/"
      />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16 sm:pb-20">
    <Eyebrow label="QUESTIONS FRÉQUENTES" />
    <h2 class="mt-4 font-display text-2xl font-semibold text-paper sm:text-3xl">
      Questions fréquentes sur les services
    </h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <CTASection
    title="Vous ne savez pas par où commencer ?"
    description="Décrivez votre activité et ce qui vous prend le plus de temps — on identifiera ensemble ce qui aurait le plus d'impact."
  />
</BaseLayout>
