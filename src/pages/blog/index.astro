---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Actualités & conseils — Lyon AI Studio"
  description="Conseils pratiques sur les sites internet et l'automatisation par IA pour les artisans, commerces et PME de Lyon."
  path="/blog/"
>
  <Breadcrumb items={[{ name: "Actualités", url: "/blog/" }]} />
  <PageHero
    eyebrow="ACTUALITÉS"
    title="Conseils pour les entreprises locales"
    description="Des articles pratiques sur le site internet et l'automatisation, sans jargon inutile."
  />

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}/`}
          class="reveal group flex flex-col overflow-hidden border border-ink-line bg-ink-soft transition-all duration-300 hover:-translate-y-1 hover:border-accent/60 hover:shadow-[0_24px_48px_-24px_rgba(226,103,44,0.35)]"
        >
          <img
            src={post.data.image}
            alt={post.data.imageAlt}
            loading="lazy"
            decoding="async"
            width="1200"
            height="675"
            class="aspect-video w-full object-cover"
          />
          <div class="flex flex-1 flex-col p-6">
            <span class="font-mono text-xs uppercase tracking-wide text-mist">
              {post.data.publishDate.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}
            </span>
            <h2 class="mt-3 font-display text-lg font-semibold text-paper group-hover:text-accent">
              {post.data.title}
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-paper-dim">{post.data.description}</p>
            <span class="mt-4 font-mono text-sm text-accent">Lire l'article →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
