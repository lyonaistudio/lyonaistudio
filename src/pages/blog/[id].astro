    {
      question: "Quand faut-il refaire son site internet ?",
      answer:
        "Quand il est lent, difficile à lire sur mobile, qu'il ne génère aucune demande de contact, qu'il n'apparaît pas sur Google ou que vous ne pouvez plus le modifier. Si plusieurs de ces signes s'accumulent, une refonte est généralement plus rentable que des corrections successives.",
    },
    {
      question: "Une refonte fait-elle perdre le référencement Google ?",
      answer:
        "Pas si elle est bien préparée : conserver les adresses qui fonctionnent ou mettre en place des redirections 301, reprendre les contenus performants et vérifier l'indexation dans Google Search Console après la mise en ligne.",
    },
    {
      question: "Refonte complète ou simple amélioration ?",
      answer:
        "Si la base technique est saine, des améliorations ciblées peuvent suffire. Si le site est lent, non adapté au mobile et impossible à modifier, repartir sur une base moderne est souvent plus judicieux.",
    },
    {
      question: "Combien de temps prend une refonte de site internet ?",
      answer:
        "Un délai comparable à une création (quelques semaines pour un site vitrine), avec une étape supplémentaire pour reprendre les contenus et préserver le référencement.",
    },
  ],
};

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const faqItems = ARTICLE_FAQ[post.id] ?? [];

const schema = articleSchema({
  title: post.data.title,
  description: post.data.description,
  slug: post.id,
  publishDate: post.data.publishDate,
  updatedDate: post.data.updatedDate,
  image: post.data.image,
});
const jsonLd = faqItems.length > 0 ? [schema, faqSchema(faqItems)] : [schema];

const pageTitle = post.data.seoTitle ?? post.data.title;
// Version JPG 1200×630 de la couverture pour les aperçus réseaux sociaux.
const ogImage = post.data.image.replace("/images/blog/", "/images/blog/og/").replace(/\.webp$/, ".jpg");
---

<BaseLayout
  title={pageTitle.length <= 42 ? `${pageTitle} — Lyon AI Studio` : pageTitle}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageAlt={post.data.imageAlt}
  article={{ publishedTime: post.data.publishDate, modifiedTime: post.data.updatedDate }}
>
  <Breadcrumb items={[{ name: "Actualités", url: "/blog/" }, { name: post.data.title, url: `/blog/${post.id}/` }]} />

  <article class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <span class="font-mono text-xs uppercase tracking-wide text-mist">
      {post.data.publishDate.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}
      {post.data.updatedDate && (
        <> · Mis à jour le <time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}</time></>
      )}
    </span>
    <h1 class="mt-3 font-display text-3xl font-bold text-paper sm:text-4xl">{post.data.title}</h1>
    <img
      src={post.data.image}
      alt={post.data.imageAlt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="1200"
      height="675"
      class="mt-8 aspect-video w-full border border-ink-line object-cover"
    />
    <div class="prose-article prose prose-invert mt-10 max-w-none">
      <Content />
    </div>

    <p class="mt-10 border-t border-ink-line pt-6 text-sm text-paper-dim">
      Écrit par <a href="/a-propos/" class="text-accent underline underline-offset-2">l'équipe Lyon AI Studio</a>.
    </p>
  </article>

  {faqItems.length > 0 && (
    <section class="mx-auto max-w-3xl px-6 pb-16 sm:pb-20">
      <Eyebrow label="QUESTIONS FRÉQUENTES" />
      <h2 class="mt-4 font-display text-2xl font-semibold text-paper sm:text-3xl">
        Questions fréquentes
      </h2>
      <div class="mt-8">
        <FAQAccordion items={faqItems} />
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20">
      <Eyebrow label="À LIRE AUSSI" />
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {relatedPosts.map((related) => (
          <a
            href={`/blog/${related.id}/`}
            class="reveal group flex flex-col rounded-3xl border border-ink-line bg-ink-soft p-6 transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/50"
          >
            <span class="text-xs font-bold uppercase tracking-wide text-mist">
              {related.data.publishDate.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}
            </span>
            <h3 class="mt-3 font-display text-lg font-bold text-paper group-hover:text-accent">
              {related.data.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-paper-dim">{related.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <CTASection
    title="Envie d'appliquer ça à votre activité ?"
    description="Chaque situation est différente. Discutons de ce qui aurait vraiment un impact pour vous."
  />
</BaseLayout>
