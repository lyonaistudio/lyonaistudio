---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CTASection from "../../components/CTASection.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { getCollection, render } from "astro:content";
import { isPublished } from "../../lib/blog";
import { articleSchema, faqSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog", isPublished);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts: posts },
  }));
}

const ARTICLE_FAQ: Record<string, { question: string; answer: string }[]> = {
  "agent-ia-commerce-local": [
    {
      question: "Un agent IA coûte-t-il cher à mettre en place pour un petit commerce ?",
      answer:
        "Ça dépend des tâches à automatiser, donc du besoin réel — il n'y a pas de tarif générique. La <a href=\"/services/automatisation-ia/\" class=\"text-accent underline underline-offset-2\">mise en place d'un agent IA</a> commence toujours par identifier ce qui prend le plus de temps au quotidien, avant de parler chiffrage.",
    },
    {
      question: "Faut-il des compétences techniques pour utiliser un agent IA au quotidien ?",
      answer:
        "Non. L'agent est configuré en amont pour votre activité ; une fois en place, il fonctionne en arrière-plan et vous n'avez à intervenir que sur ce qui nécessite vraiment votre attention.",
    },
    {
      question: "Un agent IA peut-il remplacer complètement le service client ?",
      answer:
        "Non, et ce n'est pas l'objectif. Il prend en charge les tâches répétitives (réponses simples, prise de rendez-vous, relances), pas la relation avec vos clients quand elle compte vraiment.",
    },
    {
      question: "Combien de temps avant qu'un agent IA soit vraiment opérationnel ?",
      answer:
        "Il y a d'abord une phase de test pour ajuster les règles à des cas réels, puis un temps d'adaptation une fois en ligne pour repérer les situations imprévues. Le gain de temps devient nettement perceptible une fois cette période passée.",
    },
    {
      question: "Dois-je changer mes outils actuels pour utiliser un agent IA ?",
      answer:
        "Non, l'agent se connecte à vos outils existants (agenda, catalogue, messagerie) plutôt que de les remplacer — pas de nouvel outil à apprendre en plus des autres.",
    },
  ],
  "pourquoi-artisan-site-web-2026": [
    {
      question: "Un site internet est-il vraiment utile si je travaille déjà bien avec le bouche-à-oreille ?",
      answer:
        "Oui, les deux se complètent : le bouche-à-oreille touche les gens qui vous connaissent déjà, un site capte ceux qui vous cherchent sans encore vous connaître.",
    },
    {
      question: "Combien de temps faut-il pour avoir un site internet opérationnel ?",
      answer:
        "Ça dépend de l'ampleur du projet, mais la plupart des sites pour une petite structure sont livrés en quelques semaines. Le délai exact est communiqué dans la <a href=\"/services/creation-site-internet/\" class=\"text-accent underline underline-offset-2\">proposition</a>, avant tout engagement.",
    },
    {
      question: "Un site simple suffit-il pour un artisan ?",
      answer:
        "Dans la majorité des cas, oui : ce qui compte le plus, c'est la clarté, la lisibilité sur mobile et une façon simple de vous contacter — pas la complexité du site.",
    },
    {
      question: "Que se passe-t-il si je n'ai pas de projet précis en tête ?",
      answer:
        "C'est le cas de la majorité des artisans qui nous contactent. La première étape consiste simplement à décrire votre activité et vos zones d'intervention — le reste se construit à partir de ça.",
    },
    {
      question: "Un site remplace-t-il le bouche-à-oreille ou les petites annonces ?",
      answer:
        "Non, il vient s'ajouter à ces canaux, pas les remplacer. Il capte les clients qui vous cherchent en ligne sans encore vous connaître, pendant que le bouche-à-oreille continue de fonctionner en parallèle.",
    },
  ],
  "referencement-local-lyon": [
    {
      question: "Combien de temps faut-il pour voir des résultats en référencement local ?",
      answer:
        "Ça prend du temps — ce n'est pas immédiat comme une publicité payante. C'est un travail progressif (fiche Google, cohérence des informations, avis) dont l'effet s'accumule et dure une fois en place.",
    },
    {
      question: "Le référencement local est-il vraiment gratuit ?",
      answer:
        "Les leviers eux-mêmes (fiche Google Business Profile, cohérence NAP, avis clients) sont gratuits, mais ils demandent du temps à mettre en place et à entretenir correctement — c'est ce que couvre l'accompagnement en <a href=\"/services/referencement-local-seo/\" class=\"text-accent underline underline-offset-2\">référencement local</a>.",
    },
    {
      question: "Dois-je faire de la publicité en plus du référencement local ?",
      answer:
        "Ce n'est pas obligatoire. La publicité peut accélérer les résultats à court terme, mais le bon ordre pour un budget limité est presque toujours de commencer par les bases gratuites, qui continuent de travailler une fois en place.",
    },
    {
      question: "Comment savoir si mes efforts de référencement local fonctionnent ?",
      answer:
        "La fiche Google Business Profile donne des statistiques simples (vues, appels, demandes d'itinéraire). Comparer un mois à l'autre suffit à voir si la tendance est la bonne, sans outil compliqué.",
    },
    {
      question: "Un site lent peut-il nuire à mon référencement local ?",
      answer:
        "Oui. Google privilégie une expérience de recherche fluide, et un temps de chargement trop long peut annuler l'effet des autres efforts mis en place, en plus de décourager le visiteur.",
    },
  ],
  "fiche-google-business-profile-site-internet": [
    {
      question: "Puis-je avoir uniquement une fiche Google sans site internet ?",
      answer:
        "C'est possible, mais ça limite ce que vous pouvez montrer à un client qui veut en savoir plus que les horaires et la note — c'est là que le site prend le relais.",
    },
    {
      question: "Comment relier ma fiche Google Business Profile à mon site ?",
      answer:
        "En ajoutant l'adresse du site dans les paramètres de la fiche, et en évoquant ou intégrant la fiche Google sur le site (avis, lien vers l'itinéraire) — un lien qui doit fonctionner dans les deux sens.",
    },
    {
      question: "Qui peut m'aider à optimiser ma fiche Google Business Profile ?",
      answer:
        "C'est l'un des volets de l'accompagnement en <a href=\"/services/referencement-local-seo/\" class=\"text-accent underline underline-offset-2\">référencement local</a> — <a href=\"/contact/\" class=\"text-accent underline underline-offset-2\">contactez-nous</a> pour en discuter.",
    },
    {
      question: "Faut-il répondre à tous les avis Google, même les négatifs ?",
      answer:
        "Oui. Une réponse posée à un avis négatif rassure souvent plus qu'une fiche qui n'affiche que des avis positifs sans aucune réponse visible — ça montre qu'il y a une vraie personne qui suit la fiche.",
    },
    {
      question: "Que dois-je faire en premier : la fiche Google ou le site internet ?",
      answer:
        "Les deux comptent, mais s'ils ne peuvent pas être faits en même temps, commencer par la fiche Google donne une visibilité plus rapide — le site peut suivre juste après pour capter les demandes qu'elle génère.",
    },
  ],
  "automatiser-devis-relances-tpe": [
    {
      question: "Quelles relances automatiser en priorité dans une TPE ?",
      answer:
        "Les devis sans réponse et les factures en attente de paiement : la règle est simple, le message se prépare à l'avance et le gain est immédiat. Les demandes d'avis Google après une prestation viennent juste après.",
    },
    {
      question: "Une relance automatique risque-t-elle d'agacer mes clients ?",
      answer:
        "Pas si elle est bien réglée : un message courtois, à votre ton, envoyé à un rythme raisonnable, et qui s'arrête automatiquement dès que le client répond ou paie.",
    },
    {
      question: "Faut-il changer de logiciel de facturation pour automatiser ses devis ?",
      answer:
        "Non. L'automatisation se connecte en général à vos outils existants (facturation, messagerie, agenda) plutôt que de les remplacer — voir la <a href=\"/services/automatisation-ia/\" class=\"text-accent underline underline-offset-2\">mise en place d'une automatisation</a>.",
    },
    {
      question: "Est-ce que je garde le contrôle sur les messages envoyés ?",
      answer:
        "Oui. Les messages sont relus avant la mise en service, les cas sensibles vous sont transmis, et chaque séquence peut être suspendue ou modifiée à tout moment.",
    },
  ],
  "site-vitrine-pages-indispensables": [
    {
      question: "Combien de pages faut-il pour un site vitrine ?",
      answer:
        "Il n'y a pas de nombre idéal : l'essentiel est d'avoir une page d'accueil, une page par service principal, une page de preuves (réalisations, avis), une page à propos, une page contact et les pages légales.",
    },
    {
      question: "Pourquoi faire une page par service plutôt qu'une seule page ?",
      answer:
        "Chaque page de service peut se positionner sur Google pour les recherches précises de vos clients. Une page unique qui liste tout se positionne beaucoup moins bien.",
    },
    {
      question: "Les mentions légales sont-elles obligatoires sur un site vitrine ?",
      answer:
        "Oui, en France les mentions légales et la politique de confidentialité sont obligatoires pour tout site professionnel, ainsi que les CGV si vous vendez en ligne.",
    },
    {
      question: "Un blog est-il nécessaire sur un site vitrine ?",
      answer:
        "Pas au lancement, mais c'est un excellent levier de visibilité dans la durée : chaque article qui répond à une vraie question de vos clients est une porte d'entrée supplémentaire depuis Google.",
    },
  ],
  "combien-de-temps-creer-site-internet": [
    {
      question: "Combien de temps faut-il pour créer un site vitrine ?",
      answer:
        "Pour un site vitrine simple de 5 à 8 pages, comptez généralement 3 à 6 semaines entre le premier échange et la mise en ligne, validations et contenus compris.",
    },
    {
      question: "Quelle étape prend le plus de temps dans la création d'un site ?",
      answer:
        "Presque toujours la préparation des contenus (textes, photos, informations). Les préparer dès le départ, ou les faire rédiger à partir d'un échange, est le meilleur moyen d'accélérer le projet.",
    },
    {
      question: "Peut-on créer un site internet en une semaine ?",
      answer:
        "C'est possible pour un site très simple dont tous les contenus sont prêts, mais un délai de quelques semaines permet de soigner la conception, les textes et le référencement — ce qui fait la différence sur les résultats.",
    },
    {
      question: "Le site est-il bien référencé dès sa mise en ligne ?",
      answer:
        "Les bases techniques sont en place dès le lancement, mais le positionnement sur Google se construit dans la durée — voir l'accompagnement en <a href=\"/services/referencement-local-seo/\" class=\"text-accent underline underline-offset-2\">référencement local</a>.",
    },
  ],
  "site-vitrine-ou-e-commerce": [
    {
      question: "Quelle est la différence entre un site vitrine et un site e-commerce ?",
      answer:
        "Un site vitrine présente votre activité et transforme les visiteurs en demandes de contact (appel, devis, rendez-vous). Un site e-commerce permet d'acheter et de payer directement en ligne, avec catalogue, panier, paiement et gestion des commandes.",
    },
    {
      question: "Un artisan ou un prestataire de services a-t-il besoin d'un site e-commerce ?",
      answer:
        "Rarement. Quand la vente passe par un devis ou un rendez-vous, un site vitrine est plus adapté. Il peut intégrer une prise de rendez-vous ou quelques paiements en ligne sans la complexité d'une boutique.",
    },
    {
      question: "Peut-on vendre quelques produits sur un site vitrine ?",
      answer:
        "Oui : quelques produits, des bons cadeaux ou un acompte peuvent se payer depuis un site vitrine avec un paiement en ligne simple, et le site peut évoluer vers une vraie boutique si la vente en ligne se développe.",
    },
  ],
  "site-internet-sans-clients-erreurs": [
    {
      question: "Pourquoi mon site internet ne génère-t-il aucun contact ?",
      answer:
        "Les causes les plus fréquentes : le site n'est pas trouvé sur Google, on ne comprend pas l'offre en quelques secondes, le bouton de contact est peu visible, le site est lent sur mobile, ou il manque des preuves (réalisations, avis).",
    },
    {
      question: "Par quoi commencer pour améliorer un site qui ne convertit pas ?",
      answer:
        "Par un bouton de contact visible sur chaque page et un titre d'accueil qui dit clairement ce que vous faites et pour qui : ce sont les corrections les plus rapides et les plus efficaces.",
    },
