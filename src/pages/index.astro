---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Realisations from "../components/Realisations.astro";
import Hero3DScene from "../components/Hero3DScene.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import { getCollection } from "astro:content";
import { SITE, FORMSPREE_ENDPOINT } from "../lib/site";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const expertises = [
  { title: "Création & refonte de site internet", icon: "code", href: "/services/creation-site-internet/" },
  { title: "Automatisation & agents IA", icon: "cpu", href: "/services/automatisation-ia/" },
  { title: "UX / UI Design", icon: "palette", href: "/services/ux-ui-design/" },
  { title: "Maintenance & hébergement", icon: "wrench", href: "/services/maintenance-hebergement/" },
  { title: "Référencement local / SEO", icon: "search", href: "/services/referencement-local-seo/" },
];

const chiffres = [
  { icon: "target", value: "100%", label: "sur-mesure" },
  { icon: "user", value: "1", label: "interlocuteur unique" },
  { icon: "clock", value: "48h", label: "délai de réponse" },
];

const valueCards = [
  {
    icon: "shield",
    title: "Pensé pour durer",
    text: "Un site propre et évolutif, plutôt qu'une solution qui devient obsolète en quelques années.",
  },
  {
    icon: "search",
    title: "Optimisé dès le départ",
    text: "Référencement local, vitesse de chargement, responsive : tout est pensé dès la conception.",
  },
  {
    icon: "bulb",
    title: "Pensé pour vous",
    text: "Pas de template générique. Chaque site est conçu autour de votre activité et de vos objectifs.",
  },
  {
    icon: "chart",
    title: "Conçu pour performer",
    text: "UX, rapidité, mobile : chaque détail compte pour transformer une visite en demande de contact.",
  },
];

const smallCards = [
  {
    title: "Votre projet n'est pas un numéro",
    text: "Je ne travaille que sur quelques projets à la fois, pour m'investir pleinement dans chacun.",
  },
  {
    title: "Du sur-mesure, pas du générique",
    text: "Pas de solution standardisée : votre site est pensé pour votre activité, pas pour un template.",
  },
  {
    title: "Vous parlez directement à la personne qui fait",
    text: "Pas de commercial entre vous et le travail : c'est moi qui conçois, développe et vous réponds.",
  },
  {
    title: "Je vous dis quand une idée n'est pas la bonne",
    text: "Mon rôle n'est pas seulement d'exécuter, mais de vous conseiller honnêtement.",
  },
];

const faqItems = [
  {
    question: "Combien coûte un site internet ou une automatisation ?",
    answer:
      "Chaque projet est différent, donc chaque prix l'est aussi. Plutôt que d'afficher un tarif générique qui ne correspondrait à rien de concret, je préfère d'abord comprendre votre besoin avant de vous proposer un montant clair et sans surprise.",
  },
  {
    question: "Combien de temps faut-il pour créer un site internet ?",
    answer:
      "Ça dépend de l'ampleur du projet, mais la plupart des sites pour une petite structure sont livrés en quelques semaines une fois le besoin bien défini. Le délai exact vous est communiqué dans la proposition, avant tout engagement.",
  },
  {
    question: "Je n'ai aucune connaissance technique, est-ce un problème ?",
    answer:
      "Non, c'est même la majorité des situations que je rencontre. Mon rôle est de traduire votre besoin en solution technique, pas l'inverse. Vous n'avez pas besoin de comprendre le développement web ou l'IA pour qu'on travaille ensemble.",
  },
  {
    question: "Intervenez-vous uniquement à Lyon ?",
    answer:
      "L'activité est basée à Lyon, mais l'ensemble du travail se fait à distance : je travaille avec des clients partout en France, pas seulement dans la région lyonnaise.",
  },
  {
    question: "Que se passe-t-il après la livraison si j'ai un problème ?",
    answer:
      "Les 30 jours suivant la livraison, les corrections de bugs liés à la réalisation sont incluses sans frais. Au-delà, une intervention ponctuelle ou un forfait de maintenance peuvent être mis en place.",
  },
];

const icons: Record<string, string> = {
  code: "M8 6 3 12l5 6M16 6l5 6-5 6m-3-14-2 16",
  cpu: "M9 3v3m6-3v3M9 18v3m6-3v3M3 9h3m-3 6h3m12-6h3m-3 6h3M8 8h8v8H8z",
  palette: "M12 3a9 9 0 1 0 0 18c1 0 1.5-.5 1.5-1.5s-.5-1-.5-1.5.5-1 1.5-1h1.5A3.5 3.5 0 0 0 20 13.5C20 8 16.5 3 12 3ZM7 12a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm3-4a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm5 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm2 4a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z",
  wrench: "m14.7 6.3 3 3L8 19l-3-3ZM17 3l4 4-2 2-4-4Zm-10 14 3 3-2 2-3-3Z",
  search: "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.3-4.3",
  target: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0-2.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z",
  user: "M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm-7 9c0-3.6 3.1-6.5 7-6.5s7 2.9 7 6.5",
  clock: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13v5l3.5 2",
  shield: "M12 3 4 6v6c0 4.5 3 7.7 8 9 5-1.3 8-4.5 8-9V6Zm-2.2 9.2 1.8 1.8 3.7-3.9",
  bulb: "M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.5.4.5 1 .5 1.6v.5h6v-.5c0-.6 0-1.2.5-1.6A6 6 0 0 0 12 3Z",
  chart: "M4 20V10m6 10V4m6 16v-7",
};

function Icon(name: string) {
  return icons[name] ?? icons.target;
}
---

<BaseLayout
  title="Lyon AI Studio — Sites internet et automatisation IA à Lyon"
  description="Création de sites internet et mise en place d'agents IA pour automatiser les tâches répétitives des artisans, commerces et PME, partout en France."
  path="/"
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-ink-line">
    <div class="pointer-events-none absolute inset-0">
      <Hero3DScene />
    </div>
    <div class="hero-scrim pointer-events-none absolute inset-0"></div>

    <div class="reveal relative mx-auto max-w-[1536px] px-10 py-24 sm:py-32 lg:px-20">
      <h1 class="max-w-5xl font-display text-[2.75rem] font-bold leading-[1.05] text-paper sm:text-[3.75rem] sm:leading-[1.05] lg:text-[4.25rem]">
        Un site qui vous représente. Des outils qui travaillent à votre place.
      </h1>
      <p class="mt-5 max-w-xl text-xl font-medium leading-snug text-paper-dim">
        Création de sites internet et automatisation par IA pour les artisans, commerces et PME,
        partout en France. Moins de temps sur l'administratif, plus de temps sur votre métier.
      </p>
      <p class="mt-4 flex items-center gap-2 text-sm font-bold text-paper">
        <span class="flex h-[19px] w-[19px] items-center justify-center rounded-full bg-green/15 text-[10px] text-green">✓</span>
        Basé à Lyon · Réponse sous 48h · Sans engagement
      </p>
      <div class="mt-7">
        <a
          href="/contact/"
          class="magnetic inline-flex items-center rounded-full bg-accent px-8 py-4 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-accent-soft hover:shadow-[0_8px_25px_rgba(255,0,61,0.4)]"
        >
          Parlez-moi de votre projet
        </a>
      </div>

      <!-- EXPERTISES -->
      <div class="mt-16 sm:mt-20">
        <p class="flex items-center gap-2 text-sm font-bold text-accent">
          <span aria-hidden="true">↘</span> NOS DOMAINES D'EXPERTISE
        </p>
        <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
          {expertises.map((item) => (
            <a
              href={item.href}
              class="reveal group flex min-h-[120px] flex-col items-center justify-center gap-2 rounded-2xl bg-white/[0.06] p-3 text-center backdrop-blur-md transition-colors hover:bg-white/[0.1] sm:min-h-[220px] sm:gap-6 sm:rounded-3xl sm:p-4"
            >
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" class="h-8 w-8 text-accent transition-transform group-hover:scale-110 sm:h-16 sm:w-16">
                <path d={Icon(item.icon)} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="text-xs font-bold leading-snug text-paper sm:text-lg">{item.title}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- DESC + CHIFFRES -->
  <div class="bg-[linear-gradient(180deg,#0a0a0a_15%,#2a030c_100%)]">
    <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class="grid items-center gap-16 lg:grid-cols-2">
        <div class="reveal relative mx-auto max-w-xl">
          <div class="absolute inset-0 -z-10 scale-90 rounded-full bg-accent/25 blur-[100px]" aria-hidden="true"></div>
          <img
            src="/mockups/laptop-lyonaistudio.webp"
            alt="Ordinateur portable affichant le logo Lyon AI Studio"
            width="1918"
            height="1070"
            loading="lazy"
            decoding="async"
            class="w-full"
          />
        </div>
        <div class="reveal">
          <h2 class="font-display text-3xl font-bold text-paper sm:text-4xl">
            Lyon AI Studio, un partenaire humain pour un site qui travaille pour vous.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-paper-dim">
            Votre site ne reflète plus votre activité ? Il est difficile à faire évoluer ? Il ne génère pas de
            demandes ? Vous avez besoin d'une solution sur-mesure, pas d'un gabarit générique.
          </p>
          <p class="mt-4 text-base leading-relaxed text-paper-dim">
            Un bon site commence par une compréhension de votre besoin et de celui de vos visiteurs — c'est par là
            qu'on commence, avant même de parler design.
          </p>
          <a
            href="/contact/"
            class="magnetic mt-7 inline-flex items-center rounded-full bg-accent px-7 py-3.5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-accent-soft"
          >
            Parlez-moi de votre projet
          </a>
        </div>
      </div>

      <ul class="reveal mt-20 grid grid-cols-3 gap-3 sm:gap-4">
        {chiffres.map((c) => (
          <li class="relative flex flex-col items-center gap-2 rounded-3xl bg-[#2a030c] px-3 py-6 text-center sm:flex-row sm:items-center sm:gap-0 sm:py-8 sm:pl-[100px] sm:pr-5 sm:text-left">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" class="h-7 w-7 text-white/85 sm:absolute sm:left-[28px] sm:top-1/2 sm:h-9 sm:w-9 sm:-translate-y-1/2">
              <path d={Icon(c.icon)} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <p class="font-display text-sm leading-snug text-white/85 sm:text-xl"><strong class="font-bold">{c.value}</strong> {c.label}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- VALUE CARDS -->
    <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="reveal">
          <h2 class="font-display text-3xl font-bold text-paper sm:text-4xl">
            Le sur-mesure au service de votre image
          </h2>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:mt-16 sm:grid-cols-1 sm:gap-16">
            {valueCards.slice(0, 2).map((card) => (
              <div class="rounded-3xl bg-white px-5 pb-6 pt-5 sm:px-12 sm:pb-12 sm:pt-8">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" class="h-10 w-10 text-accent sm:h-16 sm:w-16">
                  <path d={Icon(card.icon)} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3 class="mt-4 font-display text-lg font-bold text-ink sm:text-xl">{card.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-[#444] sm:text-base">{card.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="reveal lg:mt-[4.5rem]">
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-1 sm:gap-16">
            {valueCards.slice(2, 4).map((card) => (
              <div class="rounded-3xl bg-white px-5 pb-6 pt-5 sm:px-12 sm:pb-12 sm:pt-8">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" class="h-10 w-10 text-accent sm:h-16 sm:w-16">
                  <path d={Icon(card.icon)} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3 class="mt-4 font-display text-lg font-bold text-ink sm:text-xl">{card.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-[#444] sm:text-base">{card.text}</p>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-2 text-center sm:mt-16 sm:text-left">
            <a
              href="/contact/"
              class="magnetic inline-flex items-center rounded-full bg-accent px-7 py-3.5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-accent-soft"
            >
              Échanger sur votre projet
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ACCOMPAGNEMENT / STRATÉGIE DIGITALE -->
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <p class="flex items-center gap-2 text-sm font-bold text-accent">
      <span aria-hidden="true">↘</span> COMMENT JE TRAVAILLE
    </p>
    <h2 class="mt-4 max-w-2xl font-display text-3xl font-bold text-paper sm:text-4xl">
      Un accompagnement pour votre stratégie digitale
    </h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-paper-dim">
      De la création du site à l'automatisation, un interlocuteur unique basé à Lyon vous accompagne à
      chaque étape — pas une équipe commerciale, pas d'intermédiaire.
    </p>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-8">
      <figure class="reveal group overflow-hidden rounded-3xl border border-ink-line bg-ink-soft">
        <span class="block overflow-hidden">
          <img
            src="/images/about/pc2.webp"
            alt="Un site internet sur-mesure, conçu et développé avec soin"
            width="736"
            height="736"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </span>
        <figcaption class="p-4 sm:p-6">
          <p class="text-sm font-bold text-paper sm:text-lg">Un site pensé et développé sur-mesure</p>
        </figcaption>
      </figure>

      <figure class="reveal group overflow-hidden rounded-3xl border border-ink-line bg-ink-soft">
        <span class="block overflow-hidden">
          <img
            src="/images/about/lyon1.webp"
            alt="Vue de Lyon, où Lyon AI Studio est basé"
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </span>
        <figcaption class="p-4 sm:p-6">
          <p class="text-sm font-bold text-paper sm:text-lg">Basé à Lyon, disponible partout en France</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <Realisations />

  <!-- COMMENT ÇA SE PASSE (section claire, contraste) -->
  <section class="bg-[#fff8f6] py-16 text-[#1a1a1a] sm:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-14 lg:grid-cols-2">
        <div class="reveal">
          <h2 class="font-display text-3xl font-bold sm:text-4xl">
            Un projet avec <span class="text-accent">Lyon AI Studio</span>,<br />ça se déroule comment ?
          </h2>
          <p class="mt-5 max-w-md text-base leading-relaxed text-[#444]">
            Un interlocuteur unique, du premier contact à la mise en ligne. Pas plusieurs intervenants à gérer, pas
            de validation en interne à attendre — c'est moi qui m'occupe de tout, de bout en bout.
          </p>
        </div>
        <ol class="reveal grid grid-cols-2 gap-6 sm:gap-10">
          {[
            { t: "Prise de contact", d: "Vous décrivez votre besoin via le formulaire, par email ou par téléphone." },
            { t: "Échange sur le besoin", d: "On discute de votre activité, de vos contraintes, et de ce qui aurait vraiment un impact." },
            { t: "Proposition adaptée", d: "Vous recevez une proposition claire, sans jargon technique ni engagement caché." },
            { t: "Réalisation", d: "Le site ou l'automatisation est mis en place, testé, et vous êtes formé pour l'utiliser." },
          ].map((step, i) => (
            <li class="relative pl-[44px] sm:pl-[66px]">
              <span class="absolute left-0 top-0 flex h-8 w-8 items-center justify-center rounded-full bg-accent font-display text-base font-bold text-white sm:h-[43px] sm:w-[43px] sm:text-lg">
                {i + 1}
              </span>
              <h3 class="pt-1 text-base font-semibold sm:pt-2 sm:text-2xl">{step.t}</h3>
              <p class="mt-1 text-sm leading-relaxed text-[#555] sm:text-base">{step.d}</p>
            </li>
          ))}
        </ol>
      </div>

      <h2 class="reveal mt-24 text-center font-display text-3xl font-bold sm:text-4xl">
        Pourquoi travailler avec <span class="text-accent">Lyon AI Studio</span> ?
      </h2>
      <div class="reveal mt-12 grid grid-cols-2 gap-3 sm:gap-6">
        {smallCards.map((card) => (
          <div class="relative rounded-3xl bg-white py-5 pl-[54px] pr-4 sm:py-[50px] sm:pl-[96px] sm:pr-[30px]">
            <span class="absolute left-4 top-6 flex h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full bg-accent/15 text-sm text-accent sm:left-8 sm:top-1/2 sm:h-[34px] sm:w-[34px] sm:text-base" aria-hidden="true">
              ✓
            </span>
            <h3 class="text-sm font-semibold leading-tight sm:text-2xl">{card.title}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-[#555] sm:text-base">{card.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-12 text-center">
        <a
          href="/contact/"
          class="magnetic inline-flex items-center rounded-full bg-accent px-7 py-3.5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-accent-soft"
        >
          Prendre contact
        </a>
      </p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
      <Eyebrow label="ACTUALITÉS" variant="accent" />
      <h2 class="mt-4 max-w-2xl font-display text-3xl font-bold text-paper sm:text-4xl">
        Conseils pour les entreprises locales.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="reveal group flex flex-col rounded-3xl border border-ink-line bg-ink-soft p-6 transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/50"
          >
            <span class="text-xs font-bold uppercase tracking-wide text-mist">
              {post.data.publishDate.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}
            </span>
            <h3 class="mt-3 font-display text-lg font-bold text-paper group-hover:text-accent">
              {post.data.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-paper-dim">{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="bg-ink-soft py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-center font-display text-[2.5rem] font-semibold text-paper sm:text-[2.875rem]">FAQ</h2>
      <div class="mt-10">
        <FAQAccordion items={faqItems} />
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="bg-[linear-gradient(180deg,#0a0a0a_0%,#2a030c_100%)] py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-center font-display text-[2.5rem] font-semibold text-paper sm:text-[2.875rem]">
        Vous souhaitez me confier votre projet ?
      </h2>

      <div class="mt-14 grid gap-14 lg:grid-cols-2">
        <div class="reveal">
          <p class="text-lg leading-relaxed text-paper-dim">
            Je suis à votre écoute pour répondre à toutes vos questions au sujet de votre futur projet web. Je
            réponds personnellement à chaque demande, dans les plus brefs délais.
          </p>

          <div class="mt-10 space-y-6">
            <div class="flex items-center gap-5">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent text-white">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M4 4h16v12H8l-4 4V4z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <a href={`mailto:${SITE.email}`} class="text-2xl font-bold text-paper transition-colors hover:text-accent">
                {SITE.email}
              </a>
            </div>
            <div class="flex items-center gap-5">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent text-white">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <p class="text-2xl font-bold text-paper">{SITE.hours}</p>
                <p class="text-sm text-paper-dim">{SITE.city}, France — intervention à distance</p>
              </div>
            </div>
          </div>

          <div class="mt-10 flex gap-2 text-sm text-paper-dim">
            <a href="/mentions-legales/" class="transition-colors hover:text-accent">Mentions légales</a>
            <span>/</span>
            <a href="/mentions-legales/" class="transition-colors hover:text-accent">Politique de confidentialité</a>
          </div>
        </div>

        <div class="reveal">
          <form action={FORMSPREE_ENDPOINT} method="POST" class="space-y-4">
            <input type="hidden" name="_subject" value="Nouvelle demande — Lyon AI Studio (accueil)" />
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

            <div>
              <label for="home-nom" class="mb-2 block text-sm font-semibold text-paper-dim">Nom *</label>
              <input id="home-nom" name="Nom" type="text" required class="h-[60px] w-full rounded-2xl border border-white/20 bg-white/[0.06] px-5 text-paper outline-none focus:border-accent" />
            </div>
            <div>
              <label for="home-email" class="mb-2 block text-sm font-semibold text-paper-dim">E-mail *</label>
              <input id="home-email" name="Email" type="email" required class="h-[60px] w-full rounded-2xl border border-white/20 bg-white/[0.06] px-5 text-paper outline-none focus:border-accent" />
            </div>
            <div>
              <label for="home-message" class="mb-2 block text-sm font-semibold text-paper-dim">Message *</label>
              <textarea id="home-message" name="Message" rows="4" required class="w-full rounded-2xl border border-white/20 bg-white/[0.06] px-5 py-4 text-paper outline-none focus:border-accent"></textarea>
            </div>
            <div class="flex items-start gap-3">
              <input
                id="home-rgpd-consent"
                name="Consentement RGPD"
                type="checkbox"
                required
                value="J'accepte que mes informations soient utilisées pour être recontacté(e)"
                class="mt-1 h-4 w-4 shrink-0 rounded border-white/20 bg-white/[0.06] text-accent focus:ring-2 focus:ring-accent"
              />
              <label for="home-rgpd-consent" class="text-sm leading-relaxed text-paper-dim">
                J'accepte que mes informations soient utilisées pour être recontacté(e) — voir la
                <a href="/mentions-legales/" class="text-accent underline underline-offset-2">politique de confidentialité</a>.
              </label>
            </div>
            <div class="pt-2 text-center">
              <button type="submit" class="rounded-full bg-accent/75 py-4 pl-9 pr-[90px] text-lg font-bold text-white transition-all hover:bg-accent">
                Envoyer
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
