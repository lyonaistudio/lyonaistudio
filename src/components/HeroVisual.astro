---
---

<div class="pointer-events-none relative hidden h-[440px] w-full max-w-md lg:block" aria-hidden="true">
  <div class="absolute inset-0 rounded-full bg-accent/10 blur-[100px]"></div>

  <!-- Back card: mini site preview -->
  <div
    class="absolute left-4 top-6 w-[320px] -rotate-6 overflow-hidden rounded-lg border border-ink-line bg-ink-soft shadow-[0_40px_80px_-30px_rgba(0,0,0,0.8)]"
  >
    <div class="flex items-center gap-1.5 border-b border-ink-line bg-ink px-3 py-2">
      <span class="h-2 w-2 rounded-full bg-accent-dim"></span>
      <span class="h-2 w-2 rounded-full bg-mist/60"></span>
      <span class="h-2 w-2 rounded-full bg-ink-line"></span>
    </div>
    <div class="space-y-2 p-4">
      <div class="h-3 w-2/3 rounded bg-paper-dim/30"></div>
      <div class="h-2 w-full rounded bg-ink-line"></div>
      <div class="h-2 w-5/6 rounded bg-ink-line"></div>
      <div class="mt-3 h-16 w-full rounded bg-gradient-to-br from-accent/25 to-transparent"></div>
    </div>
  </div>

  <!-- Front card: AI agent notification -->
  <div
    class="absolute bottom-10 right-2 w-[280px] rotate-3 rounded-lg border border-accent/40 bg-ink-soft p-5 shadow-[0_30px_70px_-20px_rgba(226,103,44,0.4)]"
  >
    <div class="flex items-center gap-2">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent text-accent">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M4 4h16v12H8l-4 4V4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="font-mono text-xs text-mist">Nouveau message client</span>
    </div>
    <div class="mt-3 h-px w-full bg-ink-line"></div>
    <div class="mt-3 flex items-center gap-2">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent bg-accent/10 text-accent">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
          <path d="M8 12l3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="font-mono text-xs text-accent">Réponse envoyée en 30s</span>
    </div>
  </div>

  <!-- Small floating badge -->
  <div
    class="absolute right-10 top-0 rotate-2 rounded-md border border-ink-line bg-ink-soft px-3 py-2 shadow-[0_20px_40px_-20px_rgba(0,0,0,0.7)]"
  >
    <span class="font-mono text-[11px] text-paper-dim">100% sur-mesure</span>
  </div>
</div>
