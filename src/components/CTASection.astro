---
interface Props {
  title: string;
  description: string;
  buttonLabel?: string;
}

const { title, description, buttonLabel = "Faire une demande de renseignements" } = Astro.props;
---

<section class="relative overflow-hidden bg-[linear-gradient(180deg,#0a0a0a_0%,#2a030c_100%)]">
  <div class="reveal relative mx-auto max-w-3xl px-6 py-20 text-center sm:py-28">
    <h2 class="font-display text-3xl font-bold text-paper sm:text-4xl">{title}</h2>
    <p class="mt-4 text-base leading-relaxed text-paper-dim">{description}</p>
    <a
      href="/contact/"
      class="magnetic mt-8 inline-flex items-center justify-center rounded-full bg-accent px-7 py-4 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-accent-soft hover:shadow-[0_9px_25px_rgba(255,0,61,0.35)]"
    >
      {buttonLabel}
    </a>
  </div>
</section>
