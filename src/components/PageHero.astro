---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="grid-motif relative overflow-hidden border-b border-ink-line">
  <div
    class="pointer-events-none absolute -left-24 -top-32 h-96 w-96 rounded-full bg-accent/10 blur-[120px]"
    aria-hidden="true"
  ></div>
  <div class="relative mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <Eyebrow label={eyebrow} />
    <h1 class="mt-4 font-display text-4xl font-semibold text-paper sm:text-5xl">{title}</h1>
    {description && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-paper-dim">{description}</p>}
  </div>
</section>
