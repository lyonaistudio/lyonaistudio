---
// Measurement ID de la propriété Google Analytics 4. À remplacer une fois la propriété créée.
const GA_MEASUREMENT_ID = "G-XXXXXXXXXX";
---

<div
  id="cookie-consent"
  data-ga-id={GA_MEASUREMENT_ID}
  hidden
  class="fixed inset-x-0 bottom-0 z-[100] border-t border-ink-line bg-ink/97 px-6 py-5 shadow-[0_-20px_40px_-20px_rgba(0,0,0,0.6)] backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-relaxed text-paper-dim">
      Ce site utilise Google Analytics pour mesurer l'audience de façon anonyme. Ces données ne sont
      utilisées qu'à cette fin et uniquement avec votre accord. Voir notre{" "}
      <a href="/mentions-legales/" class="text-accent underline underline-offset-2 hover:text-accent-soft">politique de confidentialité</a>.
    </p>
    <div class="flex shrink-0 gap-3 font-mono text-sm">
      <button
        type="button"
        id="cookie-refuse"
        class="rounded-sm border border-ink-line px-4 py-2 font-medium text-paper transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent"
      >
        Refuser
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="rounded-sm bg-accent px-4 py-2 font-medium text-ink shadow-[0_16px_32px_-12px_rgba(226,103,44,0.5)] transition-all hover:-translate-y-0.5 hover:bg-accent-soft"
      >
        Accepter
      </button>
    </div>
  </div>
</div>

<script>
  import { initCookieConsent } from "../scripts/cookie-consent";

  document.addEventListener("astro:page-load", () => {
    const gaId = document.getElementById("cookie-consent")?.dataset.gaId;
    if (gaId) initCookieConsent(gaId);
  });
</script>
