---
const stats: { value?: string; count?: number; suffix?: string; label: string }[] = [
  { count: 100, suffix: "%", label: "Sur-mesure — aucun template générique" },
  { value: "Lyon", label: "Basé et actif dans la région lyonnaise" },
  { count: 1, suffix: "", label: "Interlocuteur unique, du site à l'automatisation" },
  { count: 48, suffix: "h", label: "Délai de réponse à chaque demande" },
];
---

<div class="stat-band relative overflow-hidden bg-ink-soft">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_120%_at_50%_0%,rgba(226,103,44,0.08),transparent)]" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl sm:grid-cols-4">
    {stats.map((stat) => (
      <div class="stat px-6 py-12 text-center sm:text-left">
        <span class="mb-3 block h-0.5 w-8 bg-accent sm:mx-0 mx-auto" aria-hidden="true"></span>
        <p class="font-display text-4xl font-bold tracking-tight text-paper drop-shadow-[0_0_24px_rgba(226,103,44,0.35)] sm:text-5xl">
          {stat.value ? (
            <span class="text-accent">{stat.value}</span>
          ) : (
            <span class="text-accent" data-count={stat.count} data-suffix={stat.suffix}>0{stat.suffix}</span>
          )}
        </p>
        <p class="mt-3 text-sm leading-snug text-paper-dim">{stat.label}</p>
      </div>
    ))}
  </div>
</div>

<script>
  import { initStatCounters } from "../scripts/stat-counter";

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".stat-band:not(.is-visible)").forEach((band) => {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.3 }
      );
      observer.observe(band);
    });
    initStatCounters();
  });
</script>
