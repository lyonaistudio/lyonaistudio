---
const stats: { value?: string; count?: number; suffix?: string; label: string }[] = [
  { count: 100, suffix: "%", label: "Sur-mesure — aucun template générique" },
  { value: "Lyon", label: "Basé et actif dans la région lyonnaise" },
  { count: 1, suffix: "", label: "Interlocuteur unique, du site à l'automatisation" },
  { count: 48, suffix: "h", label: "Délai de réponse à chaque demande" },
];
---

<div class="stat-band relative -mt-8 px-4 sm:-mt-10">
  <div class="relative mx-auto grid max-w-6xl divide-y divide-ink-line overflow-hidden rounded-3xl border border-ink-line bg-ink-soft sm:grid-cols-4 sm:divide-x sm:divide-y-0">
    {stats.map((stat) => (
      <div class="stat px-6 py-10 text-center sm:text-left">
        <span class="mb-3 block h-1 w-8 rounded-full bg-yellow sm:mx-0 mx-auto" aria-hidden="true"></span>
        <p class="font-display text-3xl font-bold text-accent sm:text-4xl">
          {stat.value ? (
            <span>{stat.value}</span>
          ) : (
            <span data-count={stat.count} data-suffix={stat.suffix}>0{stat.suffix}</span>
          )}
        </p>
        <p class="mt-3 text-sm leading-snug text-paper-dim">{stat.label}</p>
      </div>
    ))}
  </div>
</div>

<script>
  import { initStatCounters } from "../scripts/stat-counter";

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".stat-band:not(.is-visible)").forEach((band) => {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.3 }
      );
      observer.observe(band);
    });
    initStatCounters();
  });
</script>
