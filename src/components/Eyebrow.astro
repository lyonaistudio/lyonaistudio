---
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = "" } = Astro.props;
---

<p class={`inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-bold tracking-wide text-paper ${className}`}>
  <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
  <span data-scramble>{label}</span>
</p>
