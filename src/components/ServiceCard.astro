---
interface Props {
  index: string;
  title: string;
  description: string;
  points: string[];
  href: string;
}

const { index, title, description, points, href } = Astro.props;
---

<article class="reveal group relative flex flex-col overflow-hidden rounded-3xl border border-ink-line bg-ink-soft p-8 transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/50">
  <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent font-display text-sm font-bold text-white">{index}</span>
  <h3 class="mt-5 font-display text-2xl font-bold text-paper">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-paper-dim">{description}</p>
  <ul class="mt-6 space-y-2.5 border-t border-ink-line pt-6">
    {points.map((point) => (
      <li class="flex gap-2.5 text-sm font-medium text-paper">
        <span class="mt-0.5 flex h-[19px] w-[19px] shrink-0 items-center justify-center rounded-full bg-green/10 text-[10px] text-green" aria-hidden="true">✓</span>
        {point}
      </li>
    ))}
  </ul>
  <a
    href={href}
    class="mt-8 inline-flex items-center gap-2 text-sm font-bold text-accent transition-colors group-hover:text-accent-soft"
  >
    En savoir plus <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
  </a>
</article>
