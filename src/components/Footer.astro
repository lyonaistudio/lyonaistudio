---
import { SITE, NAV_LINKS } from "../lib/site";
import { SERVICES } from "../lib/schema";

const year = new Date().getFullYear();

// Même hauteur et même espacement pour chaque ligne, dans toutes les colonnes
const lien = "inline-flex min-h-[32px] items-center gap-2 text-sm text-paper-dim transition-colors hover:text-accent";
const titre = "text-xs font-bold uppercase tracking-[0.14em] text-mist";

// Icônes (traits fins, couleur du texte)
const ICONES = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  lieu: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  heure: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  google: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z"/><path d="M9.5 9.5h5"/>',
  avis: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>',
};
const icone = (nom: keyof typeof ICONES) =>
  `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-accent/80">${ICONES[nom]}</svg>`;
---

<footer class="border-t border-ink-line bg-ink">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1.05fr_1.15fr] lg:gap-12">
    <!-- Marque -->
    <div>
      <div class="flex items-center gap-1">
        <img src="/images/logo-emblem.webp" alt="" width="206" height="192" class="logo-fade -my-1 -ml-2 h-12 w-auto" loading="lazy" decoding="async" />
        <p class="font-display text-lg font-bold text-paper">
          Lyon <span class="text-accent">AI</span> Studio
        </p>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-paper-dim">
        {SITE.description}
      </p>
      <div class="mt-5 flex items-center gap-2.5">
        <a
          href="/contact/"
          class="inline-flex min-h-[40px] items-center whitespace-nowrap rounded-full bg-accent-button px-5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-accent-soft"
        >
          Devis gratuit
        </a>
        <a href={SITE.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram de Lyon AI Studio" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/15 text-paper-dim transition-colors hover:border-accent hover:text-accent">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
        </a>
        <a href={SITE.googleBusinessUrl} target="_blank" rel="noopener" aria-label="Fiche Google de Lyon AI Studio" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/15 text-paper-dim transition-colors hover:border-accent hover:text-accent">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        </a>
      </div>
    </div>

    <!-- Navigation : deux colonnes courtes -->
    <nav aria-label="Navigation du pied de page">
      <p class={titre}>Navigation</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class={lien}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Services -->
    <div>
      <p class={titre}>Services</p>
      <ul class="mt-3">
        {SERVICES.map((service) => (
          <li><a href={service.path} class={lien}>{service.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <p class={titre}>Contact</p>
      <ul class="mt-3">
        <li><a href={`mailto:${SITE.email}`} class={lien}><Fragment set:html={icone("mail")} />{SITE.email}</a></li>
        <li class="flex min-h-[32px] items-center gap-2 text-sm text-paper-dim"><Fragment set:html={icone("lieu")} />{SITE.city}, France · à distance partout</li>
        <li class="flex min-h-[32px] items-center gap-2 text-sm text-paper-dim"><Fragment set:html={icone("heure")} />{SITE.hours}</li>
        <li><a href={SITE.googleBusinessUrl} target="_blank" rel="noopener" class={lien}><Fragment set:html={icone("google")} />Notre fiche Google</a></li>
        <li><a href={SITE.googleReviewUrl} target="_blank" rel="noopener" class={lien}><Fragment set:html={icone("avis")} />Laisser un avis Google</a></li>
        <li><a href={SITE.instagramUrl} target="_blank" rel="noopener" class={lien}><Fragment set:html={icone("instagram")} />Instagram</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-4 text-xs text-mist sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Lyon AI Studio. Tous droits réservés.</p>
      <div class="flex flex-wrap gap-x-6">
        <a href="/cgv/" class="inline-flex min-h-[36px] items-center transition-colors hover:text-accent">CGV</a>
        <a href="/mentions-legales/" class="inline-flex min-h-[36px] items-center transition-colors hover:text-accent">
          Mentions légales &amp; confidentialité
        </a>
        <button type="button" data-cookie-manage class="inline-flex min-h-[36px] items-center transition-colors hover:text-accent">
          Gérer les cookies
        </button>
      </div>
    </div>
  </div>
</footer>
