---
import { SITE, NAV_LINKS } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-line bg-ink-soft">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-lg font-semibold text-paper">Lyon AI Studio</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-mist">
        {SITE.description}
      </p>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-wide text-mist">Navigation</p>
      <ul class="mt-4 space-y-2">
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-paper-dim transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-wide text-mist">Contact</p>
      <ul class="mt-4 space-y-2 text-sm text-paper-dim">
        <li>
          <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-accent">{SITE.email}</a>
        </li>
        <li>
          <a href={`tel:${SITE.phoneHref}`} class="transition-colors hover:text-accent">{SITE.phone}</a>
        </li>
        <li>{SITE.city}, France — intervention à distance</li>
        <li>{SITE.hours}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-6 text-xs text-mist sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Lyon AI Studio. Tous droits réservés.</p>
      <a href="/mentions-legales/" class="transition-colors hover:text-accent">
        Mentions légales &amp; confidentialité
      </a>
    </div>
  </div>
</footer>
