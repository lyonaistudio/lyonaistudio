---
import { SITE, NAV_LINKS } from "../lib/site";
import { SERVICES } from "../lib/schema";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-line bg-ink">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-1">
        <img src="/images/logo-emblem.webp" alt="" width="206" height="192" class="logo-fade -my-1 -ml-2 h-12 w-auto" loading="lazy" decoding="async" />
        <p class="font-display text-lg font-bold text-paper">
          Lyon <span class="text-accent">AI</span> Studio
        </p>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-paper-dim">
        {SITE.description}
      </p>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-mist">Navigation</p>
      <ul class="mt-2">
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="inline-flex min-h-[44px] items-center text-sm text-paper-dim transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-mist">Services</p>
      <ul class="mt-2">
        {SERVICES.map((service) => (
          <li>
            <a href={service.path} class="inline-flex min-h-[44px] items-center text-sm text-paper-dim transition-colors hover:text-accent">
              {service.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-mist">Contact</p>
      <ul class="mt-2 space-y-2 text-sm text-paper-dim">
        <li>
          <a href={`mailto:${SITE.email}`} class="inline-flex min-h-[44px] items-center transition-colors hover:text-accent">{SITE.email}</a>
        </li>
        <li>{SITE.city}, France — intervention à distance</li>
        <li>
          <a href={SITE.googleBusinessUrl} target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center transition-colors hover:text-accent">
            Notre fiche Google
          </a>
        </li>
        <li>
          <a href={SITE.googleReviewUrl} target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center transition-colors hover:text-accent">
            Laisser un avis Google
          </a>
        </li>
        <li>
          <a href={SITE.instagramUrl} target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-2 transition-colors hover:text-accent">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
            Instagram
          </a>
        </li>
        <li>{SITE.hours}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-6 text-xs text-mist sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Lyon AI Studio. Tous droits réservés.</p>
      <div class="flex flex-wrap gap-x-6">
        <a href="/cgv/" class="inline-flex min-h-[44px] items-center transition-colors hover:text-accent">CGV</a>
        <a href="/mentions-legales/" class="inline-flex min-h-[44px] items-center transition-colors hover:text-accent">
          Mentions légales &amp; confidentialité
        </a>
        <button type="button" data-cookie-manage class="inline-flex min-h-[44px] items-center transition-colors hover:text-accent">
          Gérer les cookies
        </button>
      </div>
    </div>
  </div>
</footer>
