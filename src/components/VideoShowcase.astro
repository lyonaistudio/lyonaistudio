---
import Eyebrow from "./Eyebrow.astro";

const VIDEOS = [
  {
    id: "video-sites",
    label: "Sites internet",
    poster: "/videos/sites-poster.jpg",
    src: "/videos/sites.mp4",
    alt: "Aperçu de la vidéo de présentation du service Sites internet",
  },
  {
    id: "video-agent-ia",
    label: "Agent IA",
    poster: "/videos/agent-ia-poster.jpg",
    src: "/videos/agent-ia.mp4",
    alt: "Aperçu de la vidéo de présentation du service Agent IA",
  },
];
---

<section class="grid-motif border-y border-ink-line">
  <div class="reveal mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:py-24 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <Eyebrow label="EN VIDÉO" />
      <h2 class="mt-4 font-display text-3xl font-semibold text-paper sm:text-4xl">
        Nos deux services, en vidéo.
      </h2>
      <p class="mt-4 max-w-md text-base leading-relaxed text-paper-dim">
        Un site qui inspire confiance dès la première visite, et un agent IA qui répond à vos
        clients à votre place — en images plutôt qu'en longs discours.
      </p>
      <a
        href="/contact/"
        class="magnetic mt-8 inline-block rounded-sm bg-accent px-6 py-3 font-mono text-sm font-medium text-ink transition-colors hover:bg-accent-soft"
      >
        Demander un échange
      </a>
    </div>

    <div class="flex flex-wrap justify-center gap-4 sm:gap-6 lg:gap-8">
      {
        VIDEOS.map((v) => (
          <div class="flex flex-col items-center gap-3">
            <span class="font-mono text-xs uppercase tracking-widest text-accent">{v.label}</span>
            <div class="phone-shell">
              <div class="phone-notch" aria-hidden="true" />
              <button
                data-video-btn={v.id}
                type="button"
                class="video-trigger"
                aria-label={`Lire la vidéo — ${v.label}`}
              >
                <img src={v.poster} alt={v.alt} loading="lazy" decoding="async" />
                <span class="play-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="none">
                    <path d="M8 5v14l11-7-11-7Z" fill="currentColor" />
                  </svg>
                </span>
              </button>
              <video id={v.id} class="hidden" playsinline controls preload="none" poster={v.poster}>
                <source src={v.src} type="video/mp4" />
              </video>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .phone-shell {
    position: relative;
    width: min(220px, 38vw);
    aspect-ratio: 9 / 16;
    border-radius: 2rem;
    border: 8px solid var(--color-ink-soft);
    outline: 2px solid var(--color-ink-line);
    overflow: hidden;
    background: var(--color-ink);
    box-shadow: 0 40px 80px -32px rgba(0, 0, 0, 0.6);
  }

  .phone-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 42%;
    height: 18px;
    background: var(--color-ink-soft);
    border-radius: 0 0 12px 12px;
    z-index: 5;
  }

  .video-trigger {
    position: absolute;
    inset: 0;
    display: block;
    cursor: pointer;
    padding: 0;
    border: 0;
  }

  .video-trigger img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-icon svg {
    color: var(--color-ink);
  }

  .play-icon::before {
    content: "";
    position: absolute;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .video-trigger:hover .play-icon::before {
    transform: scale(1.08);
  }

  .phone-shell video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone-shell video.hidden {
    display: none;
  }
</style>

<script>
  function initVideoShowcase() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-video-btn]");
    buttons.forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = "true";
      const id = btn.dataset.videoBtn;
      const video = id ? (document.getElementById(id) as HTMLVideoElement | null) : null;
      if (!video) return;
      btn.addEventListener("click", () => {
        btn.style.display = "none";
        video.classList.remove("hidden");
        video.play();
      });
    });
  }

  document.addEventListener("astro:page-load", initVideoShowcase);
</script>
