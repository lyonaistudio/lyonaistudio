---
import { NAV_LINKS } from "../lib/site";

const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-6 py-3">
    <a href="/" class="flex shrink-0 items-center gap-2 font-display text-lg font-bold text-white">
      Lyon<span class="text-accent">AI</span>Studio
    </a>

    <nav class="hidden items-center gap-4 lg:flex" aria-label="Navigation principale">
      {NAV_LINKS.map((link) => {
        const isActive = link.href === "/" ? currentPath === "/" : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`px-2.5 py-2 text-base font-bold whitespace-nowrap transition-colors hover:text-accent ${
              isActive ? "text-accent" : "text-white"
            }`}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href="/contact/"
        class="magnetic hidden items-center rounded-full bg-accent-button px-5 py-2.5 text-sm font-bold whitespace-nowrap text-white transition-all hover:-translate-y-0.5 hover:bg-accent-soft hover:shadow-[0_8px_25px_rgba(255,0,61,0.35)] lg:inline-flex"
      >
        Nous contacter
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-full bg-accent-button shadow-[0_4px_32px_rgba(255,0,61,0.6)] lg:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="h-0.5 w-5 bg-white"></span>
        <span class="h-0.5 w-5 bg-white"></span>
        <span class="h-0.5 w-5 bg-white"></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="fixed inset-0 z-30 hidden flex-col items-center justify-center gap-2 bg-ink px-6 lg:hidden"
    aria-label="Navigation mobile"
  >
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        class="rounded-full px-4 py-3 text-2xl font-bold text-white transition-colors hover:text-accent"
      >
        {link.label}
      </a>
    ))}
    <a
      href="/contact/"
      class="mt-4 rounded-full bg-accent-button px-6 py-3 text-center text-base font-bold text-white"
    >
      Nous contacter
    </a>
  </nav>
</header>
