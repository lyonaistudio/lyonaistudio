---
import Eyebrow from "./Eyebrow.astro";

const projects = [
  {
    title: "Maison Maona",
    tag: "E-commerce",
    image: "/realisations/maison-maona.jpg",
    alt: "Aperçu du site e-commerce réalisé pour Maison Maona, boutique de bijoux waterproof",
  },
  {
    title: "Safety Gadgets",
    tag: "E-commerce",
    image: "/realisations/safety-gadgets.jpg",
    alt: "Aperçu du site e-commerce Safety Gadgets, traceurs GPS et alarmes personnelles",
  },
  {
    title: "Lyon AI Studio",
    tag: "Site vitrine",
    image: "/realisations/lyon-ai-studio.jpg",
    alt: "Aperçu du site vitrine de Lyon AI Studio",
  },
];
---

<section class="border-y border-ink-line bg-ink">
  <div class="reveal mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <Eyebrow label="RÉALISATIONS" />
    <h2 class="mt-4 max-w-2xl font-display text-3xl font-bold text-paper sm:text-4xl">
      Des exemples concrets plutôt qu'une promesse.
    </h2>

    <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-3">
      {projects.map((project) => (
        <div class="block">
          <span class="block overflow-hidden rounded-2xl border border-ink-line">
            <img
              src={project.image}
              alt={project.alt}
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
              class="aspect-[8/5] w-full object-cover object-top"
            />
          </span>
          <span class="mt-5 block font-display text-xl font-bold text-paper">
            {project.title}
          </span>
          <span class="mt-3 inline-block rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-semibold text-paper-dim">
            {project.tag}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
