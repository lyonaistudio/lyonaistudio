---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<li class="reveal relative px-2 text-center sm:px-4">
  <span class="relative z-10 mx-auto mb-5 flex h-[52px] w-[52px] items-center justify-center rounded-full bg-accent-button font-display text-base font-bold text-white">
    {number}
  </span>
  <h3 class="font-display text-lg font-bold text-paper">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-paper-dim">{description}</p>
</li>
