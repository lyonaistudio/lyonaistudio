---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { SITE } from "../lib/site";
import { localBusinessSchema } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, path, jsonLd = [], ogImage = "/og-image.png" } = Astro.props;

const canonicalUrl = new URL(path, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();
const schemas = [localBusinessSchema(), ...jsonLd];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="google-site-verification" content="RJh2J0-G9U2o5x3-7oWpmXflYzQ5nET27iS-vyNowJU" />

    <!--
      GitHub Pages serves static files with no custom response headers, so a
      real CSP/HSTS/X-Frame-Options can't be sent as HTTP headers without a
      CDN in front. What CAN be enforced via <meta> is this CSP (frame-ancestors
      and the frame-busting headers are HTTP-only and are NOT achievable this
      way — noted, not silently skipped).
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://formspree.io https://hook.eu1.make.com; frame-src https://www.google.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
    />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#121110" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-ink"
    >
      Aller au contenu
    </a>
    <div class="grain-overlay" aria-hidden="true" transition:persist></div>
    <Cursor />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script>
      import { initRevealObserver } from "../scripts/reveal";
      import { initMagnetic } from "../scripts/magnetic";
      import { initScramble } from "../scripts/scramble";
      import { initMobileMenu } from "../scripts/mobile-menu";
      import { initSpotlight } from "../scripts/spotlight";

      // astro:page-load fires on the very first load AND after every
      // client-side transition, so page-specific DOM (headlines, buttons,
      // reveal targets, header) gets re-wired each time the router swaps content.
      document.addEventListener("astro:page-load", () => {
        initRevealObserver();
        initMagnetic();
        initScramble();
        initMobileMenu();
        initSpotlight();
      });
    </script>
  </body>
</html>
